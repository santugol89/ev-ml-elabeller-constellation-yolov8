<Window x:Class="GenieSupervisor.ProjectConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:local="clr-namespace:GenieSupervisor"
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextElement.FontFamily="Segoe UI"
        Left="430" Top="75" WindowStyle="None" BorderThickness="2" Width="auto" Height="auto" MaxHeight="800" BorderBrush="White"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight">
    <Grid Background="#FF686262">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="30">
            <Label x:Name="lblHeader" Content="Project"  HorizontalAlignment="Left" FontSize="15" Foreground="White" FontStyle="Italic" Margin="10,0,0,0"/>
        </StackPanel>
        <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Exit" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="ButtonSaveClose_Click"></TextBlock>
        </Border>

        <Grid Grid.Row="1" Background="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <telerik:GroupBox Grid.Row="0" Header="Project Details" Margin="5,5" FontSize="12" Foreground="White" FontFamily="Segoe UI" BorderBrush="White" BorderThickness="0.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label x:Name="lblProject" Content="Project Name: " Margin="5,0,0,0" Width="140" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite"/>
                        <TextBox x:Name="txtProjectName" Height="20" TextAlignment="Left" Width="120" Foreground="Black" BorderBrush="Black" Margin="10,0,0,0" Visibility="Collapsed" FontSize="13" FontFamily="Segoe UI" PreviewTextInput ="txtClassName_PreviewTextInput"/>
                        <telerik:RadComboBox Name="cmbProject" Height="28" Width="auto" MinWidth="100" Background="#FFFDFDFD" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                                      FontSize="14" Margin="10,0" VerticalAlignment="Center" SelectionChanged="cmbProject_SelectionChanged"/>
                        <Border Name="AddProject" Width="25" Height="25" Background="Purple" CornerRadius="50" PreviewMouseLeftButtonDown="AddProject_Click" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0">
                            <materialDesign:PackIcon Name="packIconAddProject" Background="Purple" Foreground="White" Kind="Plus" Height="18" Width="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock FontStyle="Italic" Text="Click to add new project" Foreground="Black"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,5">
                        <Label Content="Architecture: " Margin="5,0,0,0" Width="140" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite"/>
                        <telerik:RadComboBox Name="cmbArchitecture" Height="30" Width="auto" MinWidth="100" Background="#FFFDFDFD" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                                      FontSize="15" Margin="10,0" VerticalAlignment="Center" DropDownWidth="150" SelectionChanged="cmbArchitecture_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Station: " Margin="5,0,0,0" Width="140" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite"/>
                        <TextBox x:Name="txtStation" Height="25" TextAlignment="Left" Width="120" Foreground="Black" BorderBrush="Black" Margin="10,0,0,0"  FontSize="15" FontFamily="Segoe UI" PreviewTextInput ="txtClassName_PreviewTextInput"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,5">
                        <Label Content="Total Classes: " Margin="5,0,0,0" Width="140" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite"/>
                        <TextBox x:Name="txtTotalClass" Height="25" TextAlignment="Left" Width="50" Foreground="Black" BorderBrush="Black" Margin="10,0,0,0"  FontSize="15" PreviewTextInput="txtNumber_PreviewTextInput"/>
                        <Label Content="Total Lines: " Margin="70,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite" Visibility="Collapsed"/>
                        <TextBox x:Name="txtTotalLines" Height="25" TextAlignment="Left" Width="50" Foreground="Black" Visibility="Collapsed" BorderBrush="Black" Margin="10,0,0,0"  FontSize="13" PreviewTextInput="txtNumber_PreviewTextInput"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="spType" Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="False">
                        <Label Content="Annotation Type : " Margin="5,0,0,0" Width="140" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite"/>
                        <RadioButton x:Name="radRecta" Content="Rectangle/Circle" Height="20" Width="auto" Foreground="White" Padding="5,0" Margin="10,0" VerticalAlignment="Center" Visibility="Visible" IsChecked="True" VerticalContentAlignment="Center" Click="radClassType_Checked"/>
                        <RadioButton x:Name="radPoly" Content="Polyline" Height="20" Width="auto" Foreground="White" Padding="5,0" Margin="15,0" VerticalAlignment="Center" Visibility="Visible" IsChecked="False" VerticalContentAlignment="Center" Click="radClassType_Checked"/>
                        <RadioButton x:Name="radAny" Content="Any" Height="20" Width="auto" Foreground="White" Padding="5,0" Margin="15,0" VerticalAlignment="Center" Visibility="Collapsed" IsChecked="False" VerticalContentAlignment="Center" Click="radClassType_Checked"/>
                        <RadioButton x:Name="radSegregation" Content="Segregation" Height="20" Width="auto" Foreground="White" Padding="5,0" Margin="15,0" VerticalAlignment="Center" Visibility="Visible" IsChecked="False" VerticalContentAlignment="Center" Click="radClassType_Checked"/>
                    </StackPanel>
                </Grid>                
            </telerik:GroupBox>

            <telerik:GroupBox Grid.Row="1" Header="Class Details" Margin="5,5" FontSize="12" Foreground="White" FontFamily="Segoe UI" BorderBrush="White" BorderThickness="0.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="spClass" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Class Name " Margin="5,0,0,0" Width="auto" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite"/>
                        <TextBox x:Name="txtClassName" Height="20" TextAlignment="Left" Width="200" Foreground="Black" BorderBrush="Black" Margin="0"  FontSize="13" FontFamily="Segoe UI" PreviewTextInput ="txtClassName_PreviewTextInput"/>
                        <Label Content="Class Alias " Margin="25,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite"/>
                        <TextBox x:Name="txtClassAlias" Height="20" TextAlignment="Left" Width="50" Foreground="Black" BorderBrush="Black" Margin="0"  FontSize="13" FontFamily="Segoe UI" PreviewTextInput="txtString_PreviewTextInput" PreviewKeyDown="txtClassAlias_PreviewKeyDown"/>
                        <CheckBox x:Name="chkIsRealDefect" Content="Is Real Defect" FlowDirection="LeftToRight" Foreground="Wheat" IsChecked="False" Height="30" Width="auto" Padding="5,0" Margin="25,0,0,0" VerticalContentAlignment="Center">
                        </CheckBox>

                        <Border Cursor="Hand" Height="25" Width="25" CornerRadius="50" BorderBrush="DarkBlue" BorderThickness="0.1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,5">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FF6A8CA6" Offset="1"/>
                                    <GradientStop Color="DarkMagenta"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <TextBlock Height="30" Width="30" FontSize="16" TextAlignment="Center" Foreground="White" FontWeight="ExtraBold" 
                                       VerticalAlignment="Top" ToolTip="Add" HorizontalAlignment="Center" Text="+" PreviewMouseLeftButtonDown="AddClass_PreviewMouseLeftButtonDown"/>
                        </Border>
                    </StackPanel>

                    <ListView Grid.Row="1" Margin="0" HorizontalContentAlignment="Center" Foreground="Black" FontWeight="Normal" FontSize="14" Height="auto" MinHeight="100" MaxHeight = "300" 
                                  x:Name="lvProjectClass" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding}" Background="#FF5A5555">
                        <ListView.Resources>
                            <DataTemplate x:Key="DataTemplate">
                                <Border BorderBrush="White" BorderThickness="1,0,0,0"/>
                            </DataTemplate>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderBrush" Value="White"></Setter>
                                <Setter Property="BorderThickness" Value="0,0,0,0.3"></Setter>
                                <Setter Property="Height" Value="22"></Setter>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Gray"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Background" Value="#4F808080"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="#FF948F88"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>

                                <GridViewColumn Width="100" Header="Class ID">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=ClassIndex}" Foreground="DarkGoldenrod" FontWeight="SemiBold" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Class Name" Width="250">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=ClassName}" Foreground="DarkGoldenrod" FontWeight="SemiBold" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Alias" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=ClassAlias}" Foreground="DarkGoldenrod" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Type" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=ShapeCoordinates}" Foreground="DarkGoldenrod" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Operations" Width="135">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="135" VerticalAlignment="Center">
                                                <telerik:RadButton x:Name="btnRemove" BorderThickness="0" Height="25" Width="25" Background="Transparent" Margin="5,0,5,0" HorizontalAlignment="Right" Cursor="Hand" PreviewMouseDown="btnRemoveClass_PreviewMouseDown">
                                                    <telerik:RadButton.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock FontStyle="Italic" ><Run Text="Remove Class"/></TextBlock>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </telerik:RadButton.ToolTip>
                                                    <materialDesign:PackIcon Foreground="Black" Background="Transparent" Kind="Delete" Height="25" Width="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </telerik:RadButton>
                                                <telerik:RadButton x:Name="btnEdit" BorderThickness="0" Height="25" Width="25" Background="Transparent" Margin="0,0,5,0" HorizontalAlignment="Right" Cursor="Hand" PreviewMouseDown="btnEditClass_PreviewMouseDown">
                                                    <telerik:RadButton.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock FontStyle="Italic" ><Run Text="Edit Class"/></TextBlock>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </telerik:RadButton.ToolTip>
                                                    <materialDesign:PackIcon Foreground="Black" Background="Transparent" Kind="Pencil" Height="25" Width="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </telerik:RadButton>
                                                <telerik:RadButton x:Name="btnMoveUp" BorderThickness="0" Height="25" Width="25" Background="Transparent" Margin="0,0,5,0" HorizontalAlignment="Right" Cursor="Hand" PreviewMouseDown="btnMove_PreviewMouseDown">
                                                    <telerik:RadButton.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock FontStyle="Italic"><Run Text="Move Up"/></TextBlock>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </telerik:RadButton.ToolTip>
                                                    <materialDesign:PackIcon Foreground="Black" Background="Transparent" Kind="ArrowUpBoldBox" Height="25" Width="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </telerik:RadButton>
                                                <telerik:RadButton x:Name="btnMoveDown" BorderThickness="0" Height="25" Width="25" Background="Transparent" Margin="0" HorizontalAlignment="Right" Cursor="Hand" PreviewMouseDown="btnMove_PreviewMouseDown">
                                                    <telerik:RadButton.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock FontStyle="Italic"><Run Text="Move Down"/></TextBlock>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </telerik:RadButton.ToolTip>
                                                    <materialDesign:PackIcon Foreground="Black" Background="Transparent" Kind="ArrowDownBoldBox" Height="25" Width="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </telerik:RadButton>
                                            </StackPanel>                                           
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </telerik:GroupBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                <telerik:RadButton x:Name="btnGenerate" CornerRadius="10" Content="Generate Class File" BorderBrush="Black" Background="#FFB7CBDD" Foreground="Brown" 
                        telerik:StyleManager.Theme="Expression_Dark" FontSize="15" VerticalContentAlignment="Center" Width="auto" Height="27" Padding="10,0" ToolTip="Generate Class File" Click="btnGenerate_Click" Margin="10,0,10,0"/>
                <telerik:RadButton x:Name="btnDelete" CornerRadius="10" Content="Delete" BorderBrush="Black" Background="#FFB7CBDD" Foreground="Brown" 
                        telerik:StyleManager.Theme="Expression_Dark" FontSize="15" VerticalContentAlignment="Center" Width="auto" Height="27" Padding="10,0" ToolTip="Click to delete project" Click="btnDelete_Click" Margin="10,0,10,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
