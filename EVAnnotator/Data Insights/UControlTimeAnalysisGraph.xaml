<UserControl x:Class="GenieSupervisor.Data_Insights.UControlTimeAnalysisGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:GenieSupervisor.Data_Insights"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <!--<RowDefinition Height="30"/>-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Border Margin="5,0,5,0" Grid.Column="0" BorderBrush="LightGoldenrodYellow" BorderThickness="0,0,0,0.7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Choose Defects" HorizontalAlignment="Center" Foreground="LightGoldenrodYellow" VerticalAlignment="Center" FontSize="14" Margin="10,0" FontWeight="SemiBold"/>
                <telerik:RadComboBox Name="cmbDefectFilter" Grid.Row="0" Focusable="False" Padding="10,0,10,0" Text="Select Defect" Width="auto" MinWidth="150" Background="#FFFDFDFD" VerticalContentAlignment="Center" HorizontalAlignment="Center"
                                      Height="30" FontSize="13" Margin="2,5,0,0" AllowMultipleSelection="False" VerticalAlignment="Stretch" SelectionChanged="cmbDefectFilter_SelectionChanged" telerik:StyleManager.Theme="Crystal">
                    <!--<telerik:RadComboBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Padding="2,0" Content="{Binding}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource 
                                                            Mode=FindAncestor, AncestorType= telerik:RadComboBoxItem}}"/>
                </DataTemplate>
            </telerik:RadComboBox.ItemTemplate>-->
                </telerik:RadComboBox>
            </StackPanel>
        </Border>

        <telerik:RadCartesianChart 
                      x:Name="ChartTimeAnalysis"
                      Grid.Row="1"
                      Grid.Column="0"
                      Palette="Fluent"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Margin="10,0,10,10"
                      HoverMode="None" Foreground="HotPink">

            <telerik:RadCartesianChart.HorizontalAxis>
                <telerik:CategoricalAxis SmartLabelsMode="SmartStep" LabelRotationAngle="0" ShowLabels="True" LabelFitMode="Rotate" TickThickness="0" PlotMode="OnTicksPadded">
                    <telerik:CategoricalAxis.TitleTemplate>
                        <DataTemplate>
                            <TextBlock Text="" Padding="0"/>
                        </DataTemplate>
                    </telerik:CategoricalAxis.TitleTemplate>
                    <telerik:CategoricalAxis.LabelStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                            <Setter Property="Width" Value="90" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,0,0" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </telerik:CategoricalAxis.LabelStyle>
                </telerik:CategoricalAxis>
            </telerik:RadCartesianChart.HorizontalAxis>
            
            <telerik:RadCartesianChart.Series>
                <telerik:BarSeries PaletteMode="Series" ValueBinding="ClassCount" ShowLabels="True" CategoryBinding="WeekName" ItemsSource="{Binding DistByTimeWiseClass}">
                    <telerik:BarSeries.LabelDefinitions>                     
                        <telerik:ChartSeriesLabelDefinition HorizontalAlignment="Center" VerticalAlignment="Top">
                            <telerik:ChartSeriesLabelDefinition.Template>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="LightYellow" FontSize="15" FontWeight="Normal" Text="Count" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="LightYellow" FontSize="15" FontWeight="Normal" Text=" - " VerticalAlignment="Center"/>
                                        <TextBlock Foreground="LightYellow" FontSize="15" VerticalAlignment="Center" FontWeight="Normal" Text="{Binding DataItem.ClassCount}" />
                                    </StackPanel>                                   
                                </DataTemplate>
                            </telerik:ChartSeriesLabelDefinition.Template>
                        </telerik:ChartSeriesLabelDefinition>
                    </telerik:BarSeries.LabelDefinitions>
                    
                    <telerik:BarSeries.VerticalAxis>
                        <telerik:LinearAxis SmartLabelsMode="SmartStep" LabelRotationAngle="-45" LabelFitMode="None" Minimum="0" HorizontalLocation="Left" DesiredTickCount="8">
                            <telerik:LinearAxis.TitleTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Count" Padding="0" FontSize="16"/>
                                </DataTemplate>
                            </telerik:LinearAxis.TitleTemplate>
                            <telerik:LinearAxis.LabelTemplate>
                                <DataTemplate>
                                    <TextBlock Width="30" FontWeight="SemiBold" Foreground="LightGoldenrodYellow" Text="{Binding}" TextAlignment="Center" />
                                </DataTemplate>
                            </telerik:LinearAxis.LabelTemplate>
                        </telerik:LinearAxis>
                    </telerik:BarSeries.VerticalAxis>
                    <telerik:BarSeries.LegendSettings>
                        <telerik:DataPointLegendSettings TitleBinding="WeekName" />
                    </telerik:BarSeries.LegendSettings>
                    <telerik:BarSeries.TooltipTemplate>
                        <DataTemplate>
                            <Border Background="FloralWhite" BorderBrush="Black" BorderThickness="1" Padding="5" CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock HorizontalAlignment="Center">
                                            <Run Text="{Binding DataItem.WeekName}"/>
                                            <Run Text=" - "/>                                            
                                            <Run Text="{Binding DataItem.ClassCount}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </telerik:BarSeries.TooltipTemplate>
                </telerik:BarSeries>

                <telerik:LineSeries ValueBinding="ClassCount" ShowLabels="False" CategoryBinding="WeekName" ItemsSource="{Binding DistByTimeWiseClass}" StrokeThickness="1.5" Stroke="LightGray" Foreground="Black">
                    <!--<telerik:LineSeries.LabelDefinitions>
                        <telerik:ChartSeriesLabelDefinition HorizontalAlignment="Center" VerticalAlignment="Center">
                            <telerik:ChartSeriesLabelDefinition.DefaultVisualStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White" />
                                </Style>
                            </telerik:ChartSeriesLabelDefinition.DefaultVisualStyle>
                        </telerik:ChartSeriesLabelDefinition>

                        <telerik:ChartSeriesLabelDefinition HorizontalAlignment="Center" VerticalAlignment="Top">
                            <telerik:ChartSeriesLabelDefinition.Template>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="Yellow" FontWeight="Bold" Text="% Change : " />
                                        <TextBlock Margin="5,0,0,0" Foreground="Yellow" FontSize="16" FontWeight="Bold" Text="{Binding DataItem.RateChange, StringFormat={}{0}%}" />
                                    </StackPanel>                                   
                                </DataTemplate>
                            </telerik:ChartSeriesLabelDefinition.Template>
                        </telerik:ChartSeriesLabelDefinition>
                    </telerik:LineSeries.LabelDefinitions>-->
                    
                    <telerik:LineSeries.VerticalAxis>
                        <telerik:LinearAxis HorizontalLocation="Right" Margin="0,0,10,0" SmartLabelsMode="SmartStep" ShowLabels="False" TickThickness="0">
                            <telerik:LinearAxis.TitleTemplate>
                                <DataTemplate>
                                    <TextBlock Text="" Padding="0" FontSize="16"/>
                                </DataTemplate>
                            </telerik:LinearAxis.TitleTemplate>
                            <telerik:LinearAxis.LabelTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="Wheat" Text="{Binding}" TextAlignment="Right" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </telerik:LinearAxis.LabelTemplate>
                        </telerik:LinearAxis>
                    </telerik:LineSeries.VerticalAxis>
                    <telerik:LineSeries.PointTemplate>
                        <DataTemplate>
                            <Rectangle Height="7" Width="7 " Fill="WhiteSmoke"/>
                        </DataTemplate>
                    </telerik:LineSeries.PointTemplate>

                    <telerik:LineSeries.TooltipTemplate>
                        <DataTemplate>
                            <Border Background="FloralWhite" BorderBrush="Black" BorderThickness="1" Padding="5" CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock HorizontalAlignment="Center" Foreground="Brown">
                                            <Run Text="{Binding DataItem.WeekName}"/>
                                            <Run Text=" - "/>                                            
                                            <Run Text="{Binding DataItem.RateChange}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </telerik:LineSeries.TooltipTemplate>
                </telerik:LineSeries>
            </telerik:RadCartesianChart.Series>            

            <telerik:RadCartesianChart.Grid>
                <telerik:CartesianChartGrid MajorLinesVisibility="None" Opacity="0.1">
                    <telerik:CartesianChartGrid.MajorYLineStyle>
                        <Style TargetType="{x:Type Line}">
                            <Setter Property="Stroke" Value="Black"/>
                        </Style>
                    </telerik:CartesianChartGrid.MajorYLineStyle>
                </telerik:CartesianChartGrid>
            </telerik:RadCartesianChart.Grid>
            <telerik:RadCartesianChart.Behaviors>
                <telerik:ChartTooltipBehavior InitialShowDelay="0" ShowDuration="3000"/>
            </telerik:RadCartesianChart.Behaviors>
        </telerik:RadCartesianChart>

        <telerik:RadLegend Visibility="Collapsed" Items="{Binding LegendItems, ElementName=ChartTimeAnalysis}"  
                            Grid.Row="2" Grid.Column="0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center">
            <telerik:RadLegend.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </telerik:RadLegend.ItemsPanel>
            <telerik:RadLegend.Resources>
                <Style TargetType="telerik:LegendItemControl" BasedOn="{StaticResource {x:Type telerik:LegendItemControl}}">
                    <Setter Property="Margin" Value="15 0 0 0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="15" />
                </Style>
            </telerik:RadLegend.Resources>
        </telerik:RadLegend>

        <ListView x:Name="lvChangeofPercent" Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Margin="0,0,0,0" HorizontalContentAlignment="Center" Foreground="LightYellow" FontWeight="Medium" FontSize="13" BorderThickness="0,0,0,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#FF5A5A5A" IsHitTestVisible="False">
            <ListView.Resources>
                <DataTemplate x:Key="DataTemplate">
                    <Border BorderBrush="White" BorderThickness="0,0,0,0"/>
                </DataTemplate>
            </ListView.Resources>            
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="BorderBrush" Value="white"></Setter>
                    <Setter Property="BorderThickness" Value="0,0,0,0.3"></Setter>
                    <Setter Property="Height" Value="40"></Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="LightSteelBlue"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Height" Value="45"/>
                            <!--<Setter Property="HorizontalAlignment" Value="Center"/>-->
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    
                    <GridViewColumn Header="Week on Week" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=Key}" TextAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Change in %" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=Value}" TextAlignment ="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>                    
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
