<UserControl x:Class="GenieSupervisor.Data_Insights.UControlLabellingStatsGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:sfchart="clr-namespace:Syncfusion.UI.Xaml.Charts;assembly=Syncfusion.SfChart.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:GenieSupervisor.Data_Insights"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>            
            <Style x:Key="RegularTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <DataTemplate x:Key="TooltipTemplate">
                <Border IsHitTestVisible="False"
                    BorderBrush="Black"
                    BorderThickness="1" Background="LightGoldenrodYellow">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                        Margin="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="13"
                        IsHitTestVisible="False"
                        Foreground="Brown"
                        Text="{Binding Item.ClassName}" />
                        <TextBlock
                        Margin="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="13"
                        Foreground="Brown"
                        Text=":" />
                        <TextBlock
                        Margin="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="13"
                        Foreground="Brown"
                        IsHitTestVisible="False"
                        Text="{Binding YData}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>        
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <!--<sfchart:SfChart3D
            x:Name="PieChartLabellingStas"
            Grid.Row="0"
            Margin="20"
            HorizontalAlignment="Center"
            Depth="50"
            EnableRotation="True"
            PerspectiveAngle="50"
            Rotation="30"
            Tilt="180">

              --><!--Legend--><!--  
            <sfchart:SfChart3D.Legend>
                <sfchart:ChartLegend
                    BorderThickness="2"
                    CheckBoxVisibility="Visible"
                    CornerRadius="0"
                    DockPosition="Right"
                    FontSize="14"
                    RenderTransformOrigin="0.5,0.5"/>
            </sfchart:SfChart3D.Legend>

              --><!--PieSeries3D--><!--  
            <sfchart:PieSeries3D
                x:Name="pieSeries"
                sfchart:ChartTooltip.EnableAnimation="True"                
                EnableAnimation="True"
                ExplodeRadius="10"
                ExplodeOnMouseClick="True"
                ItemsSource="{Binding DistByLabelStat}"
                Label="ClassCount"               
                LabelPosition="OutsideExtended"
                Palette="Elite"
                ShowTooltip="True"     
                TooltipTemplate="{StaticResource TooltipTemplate}"
                XBindingPath="ClassName"
                YBindingPath="ClassCount">
                <sfchart:PieSeries3D.AdornmentsInfo>
                    <sfchart:ChartAdornmentInfo3D ShowConnectorLine="True" ConnectorHeight="50" UseSeriesPalette="True" ShowLabel="True" BorderBrush="White" BorderThickness="1"/>
                </sfchart:PieSeries3D.AdornmentsInfo>
            </sfchart:PieSeries3D>            
        </sfchart:SfChart3D>-->
    
        <telerik:RadPieChart x:Name="LabelStatsChart" Palette="Office2013" Grid.Row="0" Foreground="HotPink" >
            <telerik:RadPieChart.SmartLabelsStrategy>
                <telerik:PieChartSmartLabelsStrategy DisplayMode="Spider"/>
            </telerik:RadPieChart.SmartLabelsStrategy>
            <telerik:PieSeries ShowLabels="True" RadiusFactor="0.95" ItemsSource="{Binding DistByLabelStat}" Foreground="White" ValueBinding="ClassCount">
                <telerik:PieSeries.LegendSettings>
                    <telerik:DataPointLegendSettings TitleBinding="ClassName" />
                </telerik:PieSeries.LegendSettings>
                <telerik:PieSeries.LabelDefinitions>
                    <telerik:ChartSeriesLabelDefinition Margin="100,0,0,0" DefaultVisualStyle="{StaticResource RegularTextBlockStyle}">
                    </telerik:ChartSeriesLabelDefinition>
                </telerik:PieSeries.LabelDefinitions>
                <telerik:PieSeries.LabelConnectorsSettings>
                    <telerik:ChartSeriesLabelConnectorsSettings/>
                </telerik:PieSeries.LabelConnectorsSettings>
                <telerik:PieSeries.AngleRange>
                    <telerik:AngleRange StartAngle="0" SweepAngle="360" />
                </telerik:PieSeries.AngleRange>
            </telerik:PieSeries>

            <telerik:RadPieChart.Behaviors>
                <telerik:ChartSelectionBehavior DataPointSelectionMode="Single"/>
                <telerik:ChartTooltipBehavior InitialShowDelay="5" ShowDuration="2000"/>
            </telerik:RadPieChart.Behaviors>

            <telerik:RadPieChart.TooltipTemplate>
                <DataTemplate>
                    <Border Background="FloralWhite" BorderBrush="Black" BorderThickness="1" Padding="10" CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Center">
                                            <Run Text="{Binding DataItem.ClassName}"/>
                                            <Run Text="-"/>                                            
                                            <Run Text="{Binding DataItem.ClassCount}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </telerik:RadPieChart.TooltipTemplate>
        </telerik:RadPieChart>

        <telerik:RadLegend Margin="0" Items="{Binding LegendItems, ElementName=LabelStatsChart}"  Grid.Row="1" Foreground="LightGoldenrodYellow" FontSize="14"
                        HorizontalAlignment="Center"  HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center">
            <telerik:RadLegend.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </telerik:RadLegend.ItemsPanel>
            <telerik:RadLegend.Resources>
                <Style TargetType="telerik:LegendItemControl" BasedOn="{StaticResource {x:Type telerik:LegendItemControl}}">
                    <Setter Property="Margin" Value="20 0 0 0" />
                </Style>
            </telerik:RadLegend.Resources>
        </telerik:RadLegend>
    </Grid>
</UserControl>
