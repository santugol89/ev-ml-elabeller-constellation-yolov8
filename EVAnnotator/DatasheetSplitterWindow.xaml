<Window x:Class="GenieSupervisor.DatasheetSplitterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"        
        xmlns:local="clr-namespace:GenieSupervisor"
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="12"
        TextElement.FontFamily="Segoe UI"
        Left="200" Top="100" WindowStyle="None" BorderThickness="1" MinWidth="900" Width="auto" MaxWidth="{Binding SetMaxWidth}" MinHeight="250"  Height="auto" BorderBrush="Black"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent ="WidthAndHeight">
    <Window.Resources>
        <Style TargetType="WrapPanel" x:Key="ContainerStyle">
            <Style.Triggers>
                <DataTrigger>
                    <Setter Property="Background" Value="Red"/>
                </DataTrigger>      
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#FF686262" x:Name="gridWindow">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="30">
            <Label x:Name="lblHeading" Content="CSV Datasheet Splitter"  HorizontalAlignment="Left" FontSize="15" Foreground="White" FontStyle="Italic" Margin="5,0,0,0"/>
        </StackPanel>
        <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Close" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="ButtonClose_Click"/>
        </Border>
        <Grid x:Name="gridMain" Background="#FF4C3F3F" Grid.Row="1">
            <telerik:RadTabControl x:Name="tabSplit" TabStripPlacement="Top" Grid.Row="1" Grid.ColumnSpan="2" Width="auto" BorderBrush="#FFCEC4C4" 
                                   telerik:StyleManager.Theme="Expression_Dark" Margin="0,0,0,0" Align="Left" BackgroundVisibility="Collapsed" Background="Transparent" SelectionChanged="tabSplit_SelectionChanged" >
                <telerik:RadTabControl.Resources>
                    <Style TargetType="{x:Type telerik:RadTabItem}">
                        <Setter Property="Background" Value="#FF948D8D"/>
                        <Setter Property="BorderBrush" Value="#FF282828"/>
                    </Style>
                </telerik:RadTabControl.Resources>
                <telerik:RadTabItem Margin="0" Width="auto" Height="25" Padding="0">
                    <telerik:RadTabItem.Header>
                        <DockPanel >
                            <Label Content="Class/Line Selection" HorizontalContentAlignment="Center" FontWeight="SemiBold" Padding="10,0" Background="Transparent" Foreground="Brown" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </DockPanel>
                    </telerik:RadTabItem.Header>
                    <Grid x:Name="gridClass">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>
                        <telerik:GroupBox Grid.Row="0" Header="DataSheet Loaded" Margin="5,5" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                            <telerik:RadListBox x:Name="listLoadedFile" Grid.Row="1" Height="auto" Background="Transparent" ItemsSource="{Binding LoadedFileList}" MinHeight="50" MaxHeight="120" 
                                             telerik:StyleManager.Theme="Expression_Dark" Foreground="Wheat" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0,5,0,5" SelectionChanged="listLoadedFile_SelectionChanged" MaxWidth="900" SelectionMode="Extended">
                                <telerik:RadListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Padding="0,1" FontSize="12" TextAlignment="Left" Foreground="Wheat" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" />
                                    </DataTemplate>
                                </telerik:RadListBox.ItemTemplate>
                            </telerik:RadListBox>
                        </telerik:GroupBox>

                        <telerik:GroupBox x:Name="gpClass" Grid.Row="1" Header="Filter Classes" Margin="5,5" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="chkSelAllClass" Grid.Row="0" Content="Select All" FontSize="11" FlowDirection="LeftToRight" Foreground="HotPink" HorizontalAlignment="Left" Height="auto" Width="auto"
                                                Margin="5,0" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" Click="chkSelectAll_Click"/>

                                <telerik:RadListBox x:Name="ListClassView" Grid.Row="1" Background="#FF5A5555" BorderBrush="#FF5A5555" BorderThickness="1" VerticalContentAlignment="Top" Margin="0" Padding="0,10" 
                                         telerik:StyleManager.Theme="Fluent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" HorizontalAlignment="Stretch" MaxWidth="900">
                                    <telerik:RadListBox.ItemContainerStyle>
                                        <Style TargetType="telerik:RadListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type telerik:RadListBoxItem}">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </telerik:RadListBox.ItemContainerStyle>
                                    <telerik:RadListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel x:Name="wpClass" IsItemsHost="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </telerik:RadListBox.ItemsPanel>
                                    <telerik:RadListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox x:Name="chkClass" Content="{Binding ClassName}" MinWidth="200" FontSize="11" FlowDirection="LeftToRight" Foreground="Wheat" HorizontalAlignment="Left" Height="auto" Width="auto"
                                                        Margin="5" VerticalAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding IsClassEnable, Mode=TwoWay}"/>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=telerik:RadListBoxItem}}" Value="True">
                                                    <Setter TargetName="chkClass" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=chkClass, Path=IsChecked}" Value="True">
                                                    <Setter TargetName="chkClass" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </telerik:RadListBox.ItemTemplate>
                                </telerik:RadListBox>
                            </Grid>
                        </telerik:GroupBox>

                        <telerik:GroupBox x:Name="gpLine" Grid.Row="2" Header="Filter Lines" Margin="5,5" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="chkSelAllLine" Grid.Row="0" Content="Select All" FontSize="11" FlowDirection="LeftToRight" HorizontalAlignment="Left" Height="auto" Width="auto" 
                                    Margin="5,0" Foreground="HotPink" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" Click="chkSelectAll_Click"/>
                                <telerik:RadListBox x:Name="ListLineView" Grid.Row="1" Background="#FF5A5555" BorderBrush="#FF5A5555" BorderThickness="1" VerticalContentAlignment="Top" Margin="0" Padding="0,10" 
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" HorizontalAlignment="Stretch" MaxWidth="900">
                                    <telerik:RadListBox.ItemContainerStyle>
                                        <Style TargetType="telerik:RadListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type telerik:RadListBoxItem}">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </telerik:RadListBox.ItemContainerStyle>
                                    <telerik:RadListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </telerik:RadListBox.ItemsPanel>
                                    <telerik:RadListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox x:Name="chkLine" Content="{Binding LineName}" MinWidth="75" FontSize="11" FlowDirection="LeftToRight" Foreground="Wheat" HorizontalAlignment="Left" Height="auto" Width="auto"
                                                        Margin="5" VerticalAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding IsLineSelected, Mode=TwoWay}"/>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=telerik:RadListBoxItem}}" Value="True">
                                                    <Setter TargetName="chkLine" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=chkLine, Path=IsChecked}" Value="True">
                                                    <Setter TargetName="chkLine" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </telerik:RadListBox.ItemTemplate>
                                </telerik:RadListBox>
                            </Grid>
                        </telerik:GroupBox>
                        
                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,5" >
                            <telerik:RadButton x:Name="btnSelectNext" CornerRadius="10" Content="Next" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" Width="auto" 
                                    telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="15,0" ToolTip="Process and go to Next page" Click="btnSelectNext_Click"/>
                         </StackPanel>
                    </Grid>                
                </telerik:RadTabItem>

                <telerik:RadTabItem Margin="0" Width="auto" Height="25" Padding="0">
                    <telerik:RadTabItem.Header>
                        <DockPanel >
                            <Label Content="Split Datasheet" HorizontalContentAlignment="Center" Padding="10,0" FontWeight="SemiBold" Background="Transparent" Foreground="Brown" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </DockPanel>
                    </telerik:RadTabItem.Header>
                    <Grid x:Name="gridSplit">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,5">
                            <Label Foreground="AntiqueWhite"  Content="Datasheet Selected :" VerticalAlignment="Center" FontSize="14" Margin="5,0,0,0"/>
                            <TextBlock x:Name="lblDatasheetName" TextWrapping="Wrap" Height="auto" Width="auto" MaxWidth="1000" Foreground="Wheat" FontWeight="Normal" Text="" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,5">
                            <Label Foreground="AntiqueWhite"  Content="Records Available to split : " VerticalAlignment="Center" FontSize="14" Margin="5,0,5,0"/>
                            <Label x:Name="lblRecordCount" Foreground="Wheat" FontWeight="DemiBold" Content="" VerticalAlignment="Center" FontSize="14" Margin="0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,5">
                            <Label Content="Split Files into : " Margin="5,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite"/>
                            <telerik:RadRadioButton x:Name="radTwo" Content="Two" Height="auto" Width="auto" Foreground="OrangeRed" telerik:StyleManager.Theme="Office2016" Margin="15,0" FontSize="14" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="radSplit_Checked"/>
                            <telerik:RadRadioButton x:Name="radThree" Content="Three" Height="auto" Width="auto" Foreground="OrangeRed" telerik:StyleManager.Theme="Office2016" Margin="15,0" FontSize="14" VerticalAlignment="Center" IsChecked="False" VerticalContentAlignment="Center" Click="radSplit_Checked"/>
                        </StackPanel>
                        <StackPanel x:Name="spShufflePair" Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,5">
                            <Label Content="Shuffle Data with Pair : " Height="auto" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="AntiqueWhite" />
                            <CheckBox x:Name="chkPair" Height="auto" Width="auto" FontSize="14" Foreground="Wheat" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsChecked="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,5">
                            <Label Foreground="AntiqueWhite" Content="File 1 Split % : " VerticalAlignment="Center" FontSize="14" Margin="5,0,5,0"/>
                            <TextBox x:Name="txtSplit1" Width="50" MaxLength="2" Height="25" FontSize="14" Margin="5,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     PreviewTextInput="txtSplit_PreviewTextInput" TextChanged="txtSplit_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,5">
                            <Label Foreground="AntiqueWhite"  Content="File 2 Split % : " VerticalAlignment="Center" FontSize="14" Margin="5,0,5,0"/>
                            <TextBox x:Name="txtSplit2" Width="50" Height="25" MaxLength="2" FontSize="14" Margin="5,0" VerticalAlignment="Center" VerticalContentAlignment="Center" 
                                     PreviewTextInput="txtSplit_PreviewTextInput" TextChanged="txtSplit_TextChanged"/>
                        </StackPanel>
                        
                        <StackPanel x:Name="spSplit3" Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,5">
                            <Label Foreground="AntiqueWhite"  Content="File 3 Split % : " VerticalAlignment="Center" FontSize="14" Margin="5,0,5,0"/>
                            <TextBox x:Name="txtSplit3" Width="50" Height="25" FontSize="14" Margin="5,0" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Border BorderBrush="Black" Grid.Row="7"  Height="auto" Width="auto" Margin="0" BorderThickness="0,0.7,0,0" CornerRadius="0.2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,10" >
                                <telerik:RadButton x:Name="btnPrev" CornerRadius="10" Content="Previous" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" Width="auto" 
                                    telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="15,0" ToolTip="Go to Previous page" Click="btnPrev_Click" Margin="30,0,0,0"/>
                                <telerik:RadButton x:Name="btnProceed" CornerRadius="10" Content="Split and Export" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" Width="auto" 
                                    telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="15,0" ToolTip="Split the records" Click="btnProceed_Click" Margin="20,0,0,0"/>                 
                            </StackPanel>
                        </Border>
                     </Grid>
                </telerik:RadTabItem>
            </telerik:RadTabControl>            
        </Grid>
        <Popup x:Name="popUpWait" IsOpen="False" Panel.ZIndex="6" Placement="Center" PlacementTarget="{Binding ElementName=gridWindow}" AllowsTransparency="True">
            <Border BorderThickness="1" Background="#FFCCCD98" BorderBrush="Black" Height="auto" Width="auto" HorizontalAlignment="Center">
                <Label Content="Processing.. Please wait.." Width="auto" Height="auto" FontStretch="ExtraExpanded" FontWeight="Normal" FontSize="15" Padding="15,5" VerticalAlignment="Center"/>
            </Border>
        </Popup>
    </Grid>
</Window>
