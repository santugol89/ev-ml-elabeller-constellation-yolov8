<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenieSupervisor"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" x:Class="GenieSupervisor.ClassSelectionWindow"
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        Left="300" Top="100" WindowStyle="None" BorderThickness="1" Width="500" Height="auto" MaxWidth="800" MaxHeight="500" BorderBrush="Black"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight">
    <Grid Background="#FF686262">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="30">
            <Label x:Name="lblHeading" Content="Export ROI"  HorizontalAlignment="Left" FontSize="15" FontWeight="SemiBold" FontStyle="Italic" Foreground="White" Margin="10,0,0,0"/>
        </StackPanel>
        <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Close" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="ButtonClose_Click"/>
        </Border>

        <Grid x:Name="gridMain" Grid.Row="1" Background="#FF4C3F3F">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="spTop" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,10" >
                <CheckBox x:Name="chkInclude" Grid.Row="0" Content="Retrieve Unlabelled images also" FontSize="12" FlowDirection="LeftToRight" Foreground="Wheat" HorizontalAlignment="Left" Height="auto" Width="auto"
                        Margin="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>

            <telerik:GroupBox x:Name="gpClass" Grid.Row="1" Header="Filter Classes" Margin="5,5" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="chkSelAllClass" Grid.Row="0" Content="Select All" FontSize="11" FlowDirection="LeftToRight" Foreground="HotPink" HorizontalAlignment="Left" Height="auto" Width="auto"
                                                Margin="5,0" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" Click="chkSelectAll_Click"/>

                    <telerik:RadListBox x:Name="ListClassView" Grid.Row="1" Background="#FF5A5555"  BorderBrush="#FF5A5555" BorderThickness="1" 
                                        VerticalContentAlignment="Top" Margin="0" Padding="0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" HorizontalAlignment="Stretch">
                        <telerik:RadListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type telerik:RadListBoxItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type telerik:RadListBoxItem}">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </telerik:RadListBox.ItemContainerStyle>
                        
                        <telerik:RadListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel x:Name="wpClass" IsItemsHost="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </telerik:RadListBox.ItemsPanel>
                        <telerik:RadListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkClass" Content="{Binding ClassName}" MinWidth="200" FontSize="11" FlowDirection="LeftToRight" Foreground="Wheat" HorizontalAlignment="Left" Height="auto" Width="auto"
                                                        Margin="5" VerticalAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding IsClassEnable, Mode=TwoWay}"/>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type telerik:RadListBoxItem}}}" Value="True">
                                        <Setter TargetName="chkClass" Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkClass}" Value="True">
                                        <Setter TargetName="chkClass" Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </telerik:RadListBox.ItemTemplate>
                    </telerik:RadListBox>
                </Grid>
            </telerik:GroupBox>

            <StackPanel x:Name="spBottom" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,5,5" >
                <telerik:RadButton x:Name="btnProcess" CornerRadius="10" Content="Process" HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="1" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" 
                        telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="15,0" Click="btnProcess_Click" Margin="10,0,0,0"/>
                <telerik:RadButton x:Name="btnExit" CornerRadius="10" Content="Ok" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" BorderThickness="1" Foreground="Brown" FontSize="15"  
                        telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="20,0" ToolTip="Cancel and Close" PreviewMouseLeftButtonDown="ButtonClose_Click" Margin="15,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
