<Window x:Class="GenieSupervisor.WindowUserLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:GenieSupervisor"
        mc:Ignorable="d"
        Height="450" Width="350" WindowStyle="None" WindowStartupLocation="CenterScreen" BorderBrush="Transparent" ResizeMode="NoResize" ShowInTaskbar="True" AllowsTransparency="True" IsTabStop="False"
        FocusManager.FocusedElement="{Binding ElementName=tbUserAccount}">
    <Window.Background>
        <SolidColorBrush Opacity="0.9" Color="#FF230528"/>
    </Window.Background>
    <Border BorderBrush="LightGoldenrodYellow" BorderThickness="1.5" CornerRadius="0.8">
        <Grid Background="Transparent">
            <StackPanel>
                <Grid Margin="0,0,0,0">
                    <TextBlock Text="Employee Login" VerticalAlignment="Center" FontSize="20"  FontFamily="Tahoma" Foreground="White"  HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF230528" Offset="0.968"/>
                                <GradientStop Color="Red"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="ButtonClose_Click"></TextBlock>
                    </Border>
                </Grid>

                <Ellipse Width="140" Height="130" Margin="0,10,0,0">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/icon/evicon.png" Stretch="UniformToFill" AlignmentX="Left"/>
                    </Ellipse.Fill>
                </Ellipse>
                <!--<Image  Width="190" Height="100" Source="icons\Logo.png"></Image>-->
                <!--<Ellipse Height="190" Width="200" Margin="40,10,0,0">
                    <Ellipse.Fill>
                    </Ellipse.Fill>
                </Ellipse>-->
                <Grid Margin="10,20,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="UserName" VerticalAlignment="Center" FontSize="15" FontFamily="Lucida Console" Foreground="#FF87E6E8" ></TextBlock>
                    <TextBox Name ="tbUserAccount" Grid.Column="1" Height="40" FontSize="15" CaretBrush="White" Margin="5,0,0,0" Padding="1,0" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" TabIndex="0" VerticalContentAlignment="Center"/>
                </Grid>
                <Grid Margin="10,10,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Password" VerticalAlignment="Center" FontSize="15" FontFamily="Lucida Console" Background="Transparent" Foreground="#FF87E6E8"></TextBlock>
                    <PasswordBox Name ="tbPassWord" Grid.Column="1" Height="40" FontSize="15" CaretBrush="White" Margin="5,0,0,0" Padding="1,0" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" TabIndex="1" VerticalContentAlignment="Center"/>
                </Grid>
                <TextBlock Name="tbUncorrectLogin" FontSize="14" Foreground="OrangeRed" TextAlignment="Center" Text="Account or password you entered are not valid. Please, try again!" Margin="30,10,30,0" Visibility="Collapsed" TextWrapping="Wrap"></TextBlock>
            </StackPanel>
            <StackPanel Margin="0,0,0,20" VerticalAlignment="Bottom">
                <Border Width="200" Height="auto" Background="Transparent">
                    <Button x:Name="btnApply" Margin="20,0" Content="Login" HorizontalAlignment="Center" Height="auto" TabIndex="2" Background="LightGoldenrodYellow"
                        VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="20,3" Width="auto" PreviewMouseDown="LoginMouseLeftButtonDown" Foreground="Black" FontSize="16"></Button>

                    <!--<Button Background="Transparent" BorderBrush="Transparent" Click="LoginMouseLeftButtonDown" HorizontalAlignment="Stretch" Content="Login" FontSize="15" VerticalAlignment="Stretch" FontFamily="Lucida Sans" Foreground="Black" TabIndex="2">
                </Button>-->
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Label HorizontalAlignment="Center" Content="or" Foreground="White" FontSize="14"></Label>
                    <Label Height="30" IsTabStop="True" TabIndex="3">
                        <TextBlock TextDecorations="Underline" Foreground="Red" PreviewMouseLeftButtonDown="ButtonClose_Click" FontSize="14" Cursor="Hand">Close</TextBlock>
                    </Label>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Label HorizontalAlignment="Center" Content="Not Registered?" FontStyle="Italic" Foreground="LightGoldenrodYellow" FontSize="14"></Label>
                    <Label Height="30" IsTabStop="True" TabIndex="3">
                        <TextBlock TextDecorations="Underline" Foreground="HotPink" FontStyle="Normal" PreviewMouseLeftButtonDown="ButtonRegister_Click" FontSize="14" FontWeight="Normal" Cursor="Hand">Register now</TextBlock>
                    </Label>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>    
</Window>
