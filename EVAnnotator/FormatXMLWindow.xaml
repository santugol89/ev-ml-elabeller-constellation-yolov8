<Window x:Class="GenieSupervisor.FormatXMLWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenieSupervisor"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"        
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextElement.FontFamily="Segoe UI"
        Left="300" Top="150" WindowStyle="None" BorderThickness="1" MinWidth="600" Width="auto" Height="auto" BorderBrush="Black"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight">
    <Grid Background="#FF686262">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="30">
            <Label Content="Format XML"  HorizontalAlignment="Left" FontSize="15" Foreground="White" FontStyle="Italic" Margin="10,0,0,0"/>
        </StackPanel>
        <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Exit" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="btnClose_Click"></TextBlock>
        </Border>
        <Grid Grid.Row="1" Background="#FF4C3F3F">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Please select default path from below to append in XML in case path not found." Width="auto" Height="auto" Foreground="Wheat" FontSize="13" Margin="0,5,0,0" Padding="15,5" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
                <Label Content="Path " Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="Wheat"/>
                <TextBox x:Name="txtXMLImagePath" IsReadOnly="True" HorizontalAlignment="Left" Height="25" Padding="0" VerticalAlignment="Center" Width="500" Foreground="Black" BorderBrush="Black" Margin="0"  FontSize="15" FontFamily="Segoe UI"/>
                <Button x:Name="btnExportCSVPath" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" Width="27" Height="23" ToolTip="Browse to select path" Click="btnExportCSVPath_Click" Margin="10,0,10,0">
                    <Button.Background>
                        <ImageBrush ImageSource="icon/folder_icon.png"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5">
                <Label Content="Default Image size : " Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="Wheat"/>
                <RadioButton x:Name="radDef" Content="1700 X 1700" Height="25" Width="auto" Foreground="White" Padding="0" Margin="15,0" VerticalAlignment="Center" IsChecked="True" VerticalContentAlignment="Center"/>
                <RadioButton x:Name="radZero" Content="0" Height="25" Width="auto" Padding="5,1" Foreground="White" Margin="0,0" VerticalAlignment="Center" IsChecked="False" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5">
                <CheckBox x:Name="chkOverrideValid" Content="Use Import CSV Data" Foreground="White" Visibility="{Binding IsVisibleCheckbox}" IsChecked="False" Height="30" Width="auto" Padding="5,0" Margin="15,0,0,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="chkAppendReview" Content="Append Review" Foreground="White" IsChecked="True" Height="30" Width="auto" Padding="5,0" Margin="15,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
  
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                <telerik:RadButton x:Name="btnExport" Content="Export" CornerRadius="10" BorderBrush="Black" Background="#FFB7CBDD" Foreground="Brown" FontSize="14"
                                   telerik:StyleManager.Theme="Expression_Dark" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="auto" Height="25" Padding="25,0" ToolTip="Export" Click="btnXMLExport_Click" Margin="75,0,0,0"/>
                <telerik:RadButton x:Name="btnCancel" Content="Cancel" CornerRadius="10" BorderBrush="Black" Background="#FFB7CBDD" Foreground="Brown"  
                                   telerik:StyleManager.Theme="Expression_Dark" FontSize="14" VerticalContentAlignment="Center" Width="auto" Height="25" Padding="20,0" ToolTip="Cancel" PreviewMouseLeftButtonDown="btnClose_Click" Margin="10,0,10,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
