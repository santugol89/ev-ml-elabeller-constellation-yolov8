<Window x:Class="GenieSupervisor.FormatDataSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenieSupervisor"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"        
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        Left="200" Top="50" WindowStyle="None" BorderThickness="2" MinWidth="700" Width="auto" MaxWidth="900" Height="auto" MaxHeight="{Binding SetMaxColumnHieght}" MinHeight="175" BorderBrush="Black"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight" MouseDown="Window_MouseDown">
    <Grid Background="#FF686262">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="30">
            <Label x:Name="lblHeading" Content="Format DataSheet"  HorizontalAlignment="Left" FontSize="15" Foreground="White" FontStyle="Italic" Margin="5,0,0,0"/>
        </StackPanel>
        <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Close" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="ButtonClose_Click"></TextBlock>
        </Border>
        <Grid x:Name="gridMain" Grid.Row="1" Background="#FF4C3F3F">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <telerik:GroupBox x:Name="gpDataList" Grid.Row="1" Header="DataSheet Loaded" Margin="5,0" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                <telerik:RadListBox x:Name="listLoadedFile" Grid.Row="1" Height="auto" Background="Transparent" ItemsSource="{Binding LoadedFileList}" MinHeight="30" MaxHeight="110" 
                         telerik:StyleManager.Theme="Expression_Dark" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="5,5,0,10" SelectionMode="Extended" SelectionChanged="listLoadedFile_SelectionChanged">
                    <telerik:RadListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="0,3" FontSize="12" TextAlignment="Left" Foreground="Wheat" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
                        </DataTemplate>
                    </telerik:RadListBox.ItemTemplate>
                </telerik:RadListBox>
            </telerik:GroupBox>
 
            <telerik:RadToggleButton x:Name="SwitchMode" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" Content="Default" IsChecked="False" FontSize="15" Foreground="HotPink" PreviewMouseDown="SwitchMode_Click" Height="25" Style="{StaticResource RadToggleButtonStyle2}" Width="100"/>

            <!--<StackPanel x:Name="spMode" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5">
            </StackPanel>-->
            <!--<telerik:GroupBox x:Name="gpSelection" Grid.Row="1" Header="Selection Mode" Margin="5,0" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5">
                    --><!--<RadioButton x:Name="radDefault" Content="Default" IsChecked="True" FontSize="13" FlowDirection="LeftToRight"
                        HorizontalAlignment="Left" Height="auto" Width="auto"  Margin="10,0" Foreground="Black" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="radSelection_Click"/>
                    <RadioButton x:Name="radCustom" Content="Custom" FontSize="13" FlowDirection="LeftToRight"
                        HorizontalAlignment="Left" Height="auto" Width="auto"  Margin="20,0" Foreground="Black" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="radSelection_Click"/>--><!--
                </StackPanel>
            </telerik:GroupBox>-->

            <telerik:GroupBox x:Name="gpFormat" Grid.Row="2" Header="Format Option" Margin="5,0" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                <StackPanel x:Name="spDrop" Orientation="Horizontal" HorizontalAlignment="Left" >
                    <CheckBox x:Name="chkDropRows" Content="Drop Unlabelled Rows" FontSize="13" FlowDirection="LeftToRight"
                              HorizontalAlignment="Left" Height="30" Width="auto"  Margin="10,0" Foreground="Wheat" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkDropCorrectionCol" Content="Drop Correction Column" FontSize="13" FlowDirection="LeftToRight"
                              HorizontalAlignment="Left" Height="30" Width="auto"  Margin="10,0" Foreground="Wheat" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkDropDateStamp" Content="Drop DateStamp Row" FontSize="13" FlowDirection="LeftToRight"
                              HorizontalAlignment="Left" Height="30" Width="auto"  Margin="10,0" Foreground="Wheat" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkDropDLine" Content="Drop Line Name" FontSize="13" FlowDirection="LeftToRight"
                              HorizontalAlignment="Left" Height="30" Width="auto"  Margin="10,0" Foreground="Wheat" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="chkDropLine_Click"/>
                </StackPanel>
            </telerik:GroupBox>

            <telerik:GroupBox x:Name="gpClass" Grid.Row="3" Header="Filter Classes" Width="auto" Height="auto" MaxHeight="{Binding SetFilterClassHieght}" MinHeight="175" Margin="5,0" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                <Grid>
                    <Border HorizontalAlignment="Stretch" Height="30" VerticalAlignment="Top" Background="#FF4C3F3F">
                        <Grid x:Name="gridClass">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.3*"/>
                                <ColumnDefinition Width="0.1*"/>
                                <ColumnDefinition Width="0.15*"/>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="0"/>
                                <!--<ColumnDefinition Width="{Binding ColumnWidthField}"/>
                                <ColumnDefinition Width="{Binding ColumnWidthField}"/>-->
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="chkSelAllClass" Grid.Column="0" Content="Select All" FontSize="11" FlowDirection="LeftToRight" Foreground="HotPink" HorizontalAlignment="Left" Height="auto" Width="auto"
                                Margin="5,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" Click="chkSelectAll_Click"/>
                            <TextBlock VerticalAlignment="Center" TextAlignment="Left" Grid.Column="1" Text="Count" Foreground="HotPink" FontSize="11"  FontWeight="SemiBold"></TextBlock>
                            <TextBlock VerticalAlignment="Center" TextAlignment="Left" Grid.Column="2" Text="Export Count" Foreground="HotPink" FontSize="11"  FontWeight="SemiBold"></TextBlock>
                            <TextBlock VerticalAlignment="Center" TextAlignment="Left" Grid.Column="3" Text="{Binding ContentFieldText}" Foreground="HotPink" FontSize="11"  FontWeight="SemiBold"></TextBlock>
                            <TextBlock VerticalAlignment="Center" TextAlignment="Left" Grid.Column="4" Margin="0,0,25,0" Text="Single Spot" Visibility="{Binding VisibilityField}" Foreground="HotPink" FontSize="11"  FontWeight="SemiBold"></TextBlock>
                            <TextBlock VerticalAlignment="Center" TextAlignment="Left" Grid.Column="5" Margin="0,0,25,0" Text="Phase Contrast" Visibility="{Binding VisibilityField}" Foreground="HotPink" FontSize="11"  FontWeight="SemiBold"></TextBlock>
                        </Grid>
                    </Border>
                    <telerik:RadListBox x:Name="ListClassView" Background="#FF5A5555"  BorderBrush="LightBlue" BorderThickness="1" VerticalContentAlignment="Top" 
                                        telerik:StyleManager.Theme="Expression_Dark" Margin="0,30,0,0" Padding="0,10" ScrollViewer.CanContentScroll="False" HorizontalAlignment="Stretch">
                        <telerik:RadListBox.ItemContainerStyle>
                            <Style TargetType="telerik:RadListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type telerik:RadListBoxItem}">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </telerik:RadListBox.ItemContainerStyle>
                        <telerik:RadListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Name="HighlightBorder" Margin="0" Padding="3" BorderThickness="0" BorderBrush="#FF606060">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.3*"/>
                                            <ColumnDefinition Width="0.1*"/>
                                            <ColumnDefinition Width="0.15*"/>
                                            <ColumnDefinition Width="0"/>
                                            <ColumnDefinition Width="0"/>
                                            <ColumnDefinition Width="0"/>
                                            <!--<ColumnDefinition Width="{Binding ColumnWidthExportField}"/>
                                            <ColumnDefinition Width="{Binding ColumnWidthExportField}"/>-->
                                        </Grid.ColumnDefinitions>

                                        <CheckBox x:Name="chkClass" Grid.Column="0" Content="{Binding ClassName}" FontSize="11" FlowDirection="LeftToRight" Foreground="Wheat" HorizontalAlignment="Left" Height="auto" Width="auto"
                                                        Margin="0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding IsClassEnable, Mode=TwoWay}"/>

                                        <TextBlock Grid.Column="1" Text="{Binding ClassCount}" Margin="5,0" Height="auto" Width="auto" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="Wheat" FontSize="11"/>

                                        <TextBox Grid.Column="2" Text="{Binding ModifiedCount}" TextAlignment="Center" BorderThickness="1" BorderBrush="Wheat" Background="White" FontWeight="Regular" 
                                                 HorizontalAlignment="Left" Margin="10,0" Padding="5,0" VerticalAlignment="Center" Width="50" IsEnabled="{Binding IsClassEnable}" PreviewTextInput ="txtCount_PreviewTextInput" PreviewKeyUp="txtCount_PreviewKeyUp" />

                                        <RadioButton Tag="1" Content="{Binding ModifiedCount}" Grid.Column="3" Height="auto" Width="auto" Foreground="Wheat" Background="Wheat" FontSize="11" BorderBrush="Purple" BorderThickness="1" VerticalContentAlignment="Center" 
                                                        HorizontalContentAlignment="Center" Margin="15,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="True" IsEnabled="{Binding IsClassEnable}" Click="radOption_Click"/>

                                        <RadioButton Tag="2" Content="{Binding ExportSinglespot}" Grid.Column="4" Height="auto" Width="auto" Foreground="Wheat" Background="Wheat" FontSize="11" BorderBrush="Purple" BorderThickness="1" VerticalContentAlignment="Center" 
                                                        HorizontalContentAlignment="Center" Margin="15,0" Visibility="{Binding VisibilityExportField}" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="False" IsEnabled="{Binding IsClassEnable}" Click="radOption_Click"/>

                                        <RadioButton Tag="3" Content="{Binding ExportPhaseContrast}" Grid.Column="5" Height="auto" Width="auto" Foreground="Wheat" Background="Wheat" FontSize="11" BorderBrush="Purple" BorderThickness="1" VerticalContentAlignment="Center"
                                                        HorizontalContentAlignment="Center" Margin="15,0" Visibility="{Binding VisibilityExportField}" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="False" IsEnabled="{Binding IsClassEnable}" Click="radOption_Click"/>

                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=telerik:RadListBoxItem}}" 
                                         Value="True">
                                        <Setter TargetName="HighlightBorder" Property="BorderThickness" Value="1" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard TargetName="HighlightBorder" TargetProperty="Background.Color">
                                                    <ColorAnimation To="#FF5C5C77" Duration="0:0:0.3" AutoReverse="true" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=telerik:RadListBoxItem}}" Value="True">
                                        <Setter TargetName="HighlightBorder" Property="Background" Value="#4F908787" />
                                        <Setter TargetName="chkClass" Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=chkClass, Path=IsChecked}" Value="True">
                                        <Setter TargetName="chkClass" Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </telerik:RadListBox.ItemTemplate>
                    </telerik:RadListBox>
                </Grid>
            </telerik:GroupBox>

            <telerik:GroupBox x:Name="gpLine" Grid.Row="4" Header="Filter Lines" Margin="5,0" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="chkSelAllLine" Grid.Row="0" Content="Select All" FontSize="11" FlowDirection="LeftToRight" HorizontalAlignment="Left" Height="auto" Width="auto" 
                               Margin="5,0" Foreground="HotPink" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" Click="chkSelectAll_Click"/>
                    <telerik:RadListBox x:Name="ListLineView" Grid.Row="1" Background="#FF5A5555" MinHeight="50" Height="auto" MaxHeight="100" BorderBrush="LightBlue" BorderThickness="1" VerticalContentAlignment="Top" Margin="0" Padding="0,10" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" HorizontalAlignment="Stretch">
                        <telerik:RadListBox.ItemContainerStyle>
                            <Style TargetType="telerik:RadListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type telerik:RadListBoxItem}">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </telerik:RadListBox.ItemContainerStyle>
                        <telerik:RadListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </telerik:RadListBox.ItemsPanel>
                        <telerik:RadListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkLine" Content="{Binding LineName}" MinWidth="75" FontSize="11" FlowDirection="LeftToRight" Foreground="Wheat" HorizontalAlignment="Left" Height="auto" Width="auto"
                                                        Margin="5" VerticalAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding IsLineSelected, Mode=TwoWay}"/>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=telerik:RadListBoxItem}}" Value="True">
                                        <Setter TargetName="chkLine" Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=chkLine, Path=IsChecked}" Value="True">
                                        <Setter TargetName="chkLine" Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </telerik:RadListBox.ItemTemplate>
                    </telerik:RadListBox>
                </Grid>
            </telerik:GroupBox>

            <telerik:GroupBox x:Name="gpLinePath" Grid.Row="5" Header="Select Lines Path" Margin="5,0" Height="auto" Width="auto" Foreground="White" FontSize="12" BorderBrush="White" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,5,0,0">
                        <Label Content="Image Folder : " Foreground="Wheat" VerticalAlignment="Center" Margin="0,0"/>
                        <TextBox x:Name="txtImagePath" HorizontalAlignment="Left" Height="auto" Padding="2" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="500" Foreground="Black" BorderBrush="Black" Margin="5,0,0,0"/>
                        <Button x:Name="btnBrowseImagePath" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" Width="25" Height="20" ToolTip="Browse for Image Path" Click="btnBrowseImagePath_Click" Margin="10,0,0,0">
                            <Button.Background>
                                <ImageBrush ImageSource="icon/folder_icon.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,5,0,0">
                        <Label>
                            <materialDesign:PackIcon Foreground="Yellow" Kind="LightbulbOn" Height="15" Width="15"/>
                        </Label>
                        <Label Content="Selected Image Path will add the respective Line name in formated datasheet." Margin="0,0" FontSize="10" Foreground="LightYellow" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </telerik:GroupBox>

            <StackPanel x:Name="spBottom" Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,10" >
                <telerik:RadButton x:Name="btnExportClasswise" CornerRadius="10" Content="Export as Classwise Files" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="15,0" ToolTip="Click to Export Files as Classwise" Click="btnExportClasswise_Click" Margin="10,0,0,0" Visibility="Collapsed"/>
                <telerik:RadButton x:Name="btnExportSingle" CornerRadius="10" Content="Export as Single File" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="15,0" ToolTip="Click to Merge Single file and Export" Click="btnExportDatasheet_Click" Margin="10,0,0,0"/>
                <telerik:RadButton x:Name="btnExportMany" CornerRadius="10" Content="Export as Multiple Files" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="15,0" ToolTip="Click to Export as Multiple files" Click="btnExportDatasheet_Click" Margin="30,0,0,0"/>
                <telerik:RadButton x:Name="btnExit" CornerRadius="10" Content="Ok" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="20,0" ToolTip="Close" PreviewMouseLeftButtonDown="ButtonSaveClose_Click" Margin="30,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
