<Window x:Class="GenieSupervisor.ManageAndMergeDatasheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenieSupervisor"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"        
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextElement.FontFamily="Segoe UI"
        Left="300" Top="100" WindowStyle="None" BorderThickness="1" Width="auto" MinWidth="700" MaxWidth="1000" Height="auto" MaxHeight="380" BorderBrush="Black"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" MinHeight="180" SizeToContent="WidthAndHeight">
    <Grid Background="#FF686262">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="30">
            <Label Content="Manage and Merge Datasheets"  HorizontalAlignment="Left" FontSize="15" Foreground="White"  FontStyle="Italic" Margin="10,0,0,0"/>
        </StackPanel>
        
        <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Exit" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="ButtonSaveClose_Click"/>
        </Border>

        <Grid Grid.Row="1" Background="#FF4C3F3F">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="0" CornerRadius="5" Margin="5,5,5,0" Background="Transparent">
                <StackPanel  Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Height="auto">
                    <telerik:RadButton x:Name="btnMergeDatasheet" Content="Merge" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFEAF3F4" Foreground="Black" FontWeight="SemiBold" FontSize="14" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" CornerRadius="10" Height="30" Padding="10,0" ToolTip="Merge selected Datasheet" IsEnabled="{Binding IsEnableMergeButton}" PreviewMouseLeftButtonDown="ButtonMergeDatasheet_Click"/>
                    <telerik:RadButton x:Name="btnMergeAllDatasheet" Content="Merge All" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFEAF3F4" Foreground="Black" FontWeight="SemiBold" FontSize="14" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" CornerRadius="10" Height="30" Padding="10,0" ToolTip="Merge to one Datasheet" IsEnabled="{Binding IsEnableMergeAllButton}" PreviewMouseLeftButtonDown="ButtonMergeDatasheet_Click" Margin="20,0,0,0"/>
                    <telerik:RadButton x:Name="btnDeleteDatasheet" Content="Delete" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFEAF3F4" Foreground="Black" FontWeight="SemiBold" FontSize="14" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" CornerRadius="10" Height="30" Padding="10,0" ToolTip="Delete Selected Datasheet" IsEnabled="{Binding IsEnableDeleteButton}" PreviewMouseLeftButtonDown="ButtonDelete_Click" Margin="20,0,0,0"/>
                    <telerik:RadButton x:Name="btnDeleteAll" Content="Delete All" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFEAF3F4" Foreground="Black" FontWeight="SemiBold" FontSize="14" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" CornerRadius="10" Height="30" Padding="10,0" ToolTip="Delete All Datasheet" IsEnabled="{Binding IsEnableDeleteAllButton}" PreviewMouseLeftButtonDown="ButtonDeleteAll_Click" Margin="20,0,0,0"/>
                </StackPanel>
            </Border>

            <telerik:GroupBox Grid.Row="1" Header="DataSheet Loaded" Height="auto" Margin="5,0,5,0" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                <telerik:RadListBox x:Name="listLoadedFile" Grid.Row="1" Height="auto" Background="Transparent" MinHeight="100" MaxHeight="300" telerik:StyleManager.Theme="Expression_Dark"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended" Padding="5,5,0,10" SelectionChanged="listLoadedFile_SelectionChanged" LostFocus="listLoadedFile_LostFocus">
                    <telerik:RadListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="0,2" FontSize="12" TextAlignment="Left" Foreground="Wheat" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
                        </DataTemplate>
                    </telerik:RadListBox.ItemTemplate>
                </telerik:RadListBox>
            </telerik:GroupBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Height="auto" Margin="0,0,15,0">
                <telerik:RadButton x:Name="btnExit" CornerRadius="10" Content="OK" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" Height="25" Padding="20,0" ToolTip="Close" PreviewMouseLeftButtonDown="ButtonSaveClose_Click" Margin="20,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
