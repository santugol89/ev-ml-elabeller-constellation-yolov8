<Window x:Class="GenieSupervisor.DataFolderSplitter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenieSupervisor"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"        
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextElement.FontFamily="Segoe UI"
        Left="300" Top="150" WindowStyle="None" BorderThickness="1" MinWidth="350" Width="auto" Height="auto" BorderBrush="Black"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight">
    <Grid Background="#FF686262">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="30">
            <Label x:Name="lblHeading" Content="Train/Validation/Test Set Splitter"  HorizontalAlignment="Left" FontSize="14" Foreground="White" FontStyle="Italic" Margin="5,0,0,0"/>
        </StackPanel>
        <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Exit" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="btnClose_Click"></TextBlock>
        </Border>

        <Grid Grid.Row="1" Background="#FF4C3F3F">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label x:Name ="lblLabelImage"  Content="Labelled Images : " Width="auto" Height="auto" Foreground="LightGoldenrodYellow" FontSize="15" Margin="0,5,0,0" Padding="10,5" VerticalAlignment="Center"/>
                <Label x:Name="lblImageCount" Width="auto" Height="auto" Foreground="LightGoldenrodYellow" FontSize="15" Margin="0,5,0,0" Padding="10,5" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="spRegion" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" >
                <Label Content="Labelled Regions : " Width="auto" Height="auto" Foreground="LightGoldenrodYellow" FontSize="15" Margin="0,5,0,0" Padding="10,5" VerticalAlignment="Center"/>
                <Label x:Name="lblRegionCount" Width="auto" Height="auto" Foreground="LightGoldenrodYellow" FontSize="15" Margin="0,5,0,0" Padding="10,5" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
            <Label Grid.Row="1" Content="Select Split Ratio" Width="auto" Height="auto" Foreground="Wheat" FontSize="15" Margin="0,5,0,0" Padding="10,5" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,20,0">
                <Label Content="Train  % " Margin="5,0,0,0" VerticalAlignment="Center" FontSize="14" Width="90" Foreground="White"/>
                <ComboBox x:Name="cmbTrain" HorizontalAlignment="Left" Height="auto" Padding="5,0,0,0" VerticalAlignment="Center" Width="50" Foreground="Black" FontWeight="SemiBold"
                         BorderBrush="Black" Margin="0"  FontSize="16" FontFamily="Segoe UI" SelectionChanged="cmbTrain_SelectionChanged"/>

                <!--<TextBox x:Name="txtTrain" HorizontalAlignment="Left" Height="25" Padding="0" VerticalAlignment="Center" Width="50" Foreground="Black" 
                         BorderBrush="Black" Margin="0"  FontSize="16" FontFamily="Segoe UI" PreviewTextInput="txtSplit_PreviewTextInput" TextChanged="txtSplit_TextChanged"/>-->

                <Label Content="Validation % " Margin="20,0,0,0" VerticalAlignment="Center" FontSize="14" Width="90" Foreground="White"/>
                <TextBox x:Name="txtVal" IsEnabled="False" HorizontalAlignment="Left" Height="auto" Padding="0" VerticalAlignment="Center" Width="50" Foreground="Black" FontWeight="SemiBold"
                         BorderBrush="Black" Margin="0"  FontSize="16" FontFamily="Segoe UI"/>

                <!--<TextBox x:Name="txtVal" IsEnabled="True" HorizontalAlignment="Left" Height="25" Padding="0" VerticalAlignment="Center" Width="50"
                         Foreground="Black" BorderBrush="Black" Margin="0"  FontSize="16" FontFamily="Segoe UI" PreviewTextInput="txtSplit_PreviewTextInput"/>-->

                <Label Content="Test % " Margin="20,0,00,0" VerticalAlignment="Center" FontSize="14" Width="80" Foreground="White"/>
                <TextBox x:Name="txtTest" IsEnabled="False" HorizontalAlignment="Left" Height="auto" Padding="0" VerticalAlignment="Center" Width="50" Foreground="Black" 
                         BorderBrush="Black" Margin="0"  FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold"/>

                <!--<TextBox x:Name="txtTestSet" IsEnabled="False" HorizontalAlignment="Left" Height="25" Padding="0" VerticalAlignment="Center" Width="50"
                         Foreground="Black" BorderBrush="Black" Margin="0"  FontSize="16" FontFamily="Segoe UI" PreviewTextInput="txtSplit_PreviewTextInput"/>-->

            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,20,0" Visibility="Collapsed">
                <Label Content="Train Data : " Margin="5,0,0,0" VerticalAlignment="Center" FontSize="14" Width="90" Foreground="White"/>
                <TextBlock x:Name="txtTrainData" HorizontalAlignment="Center" Height="auto" Padding="0" VerticalAlignment="Center" Width="50" Foreground="White" 
                         Margin="0"  FontSize="16" FontFamily="Segoe UI"/>

                <Label Content="Val data : " Margin="20,0,0,0" VerticalAlignment="Center" FontSize="14" Width="90" Foreground="White"/>
                <TextBlock x:Name="txtValData" HorizontalAlignment="Center" Height="auto" Padding="0" VerticalAlignment="Center" Width="50" Foreground="White" 
                         Margin="0"  FontSize="16" FontFamily="Segoe UI"/>

                <Label Content="Test Data : " Margin="20,0,00,0" VerticalAlignment="Center" FontSize="14" Width="80" Foreground="White"/>
                <TextBlock x:Name="txtTestData" HorizontalAlignment="Center" Height="auto" Padding="0" VerticalAlignment="Center" Width="50" Foreground="White" 
                         Margin="0"  FontSize="16" FontFamily="Segoe UI"/>
            </StackPanel>

            <CheckBox x:Name="chkCopySource" Grid.Row="4" Content="Copy loaded images to Source folder" Visibility="Visible" Foreground="Wheat" VerticalAlignment="Center" IsChecked="True" FontSize="15" Height="30" Width="auto" Padding="10,0,0,3" Margin="15,10,15,0" VerticalContentAlignment="Center"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                <telerik:RadButton x:Name="btnProceed" Content="Proceed" CornerRadius="10" BorderBrush="Black" Background="#FFB7CBDD" Foreground="Brown" FontSize="16" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" Height="auto" Padding="15,5" ToolTip="Proceed For Folder Split" Click="btnProceed_Click" Margin="0,0,10,0"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
