<Window x:Class="GenieSupervisor.ImageStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenieSupervisor"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        WindowState="Normal" 
        mc:Ignorable="d"
        TextElement.FontWeight="Normal"
        Topmost="True"
        TextElement.FontSize="14"
        Background="#3F0A3854"
        Foreground="Black"
        Left="1080" Top="265" WindowStyle="None" BorderThickness="1" Width="450" Height="490" BorderBrush="Black"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False" 
        ContentRendered="Window_ContentRendered" Title="ImageStats">


    <Grid Margin="0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Background="#FF686262" Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Height="30" Margin="0,0,-0.2,0.4">
            <Label Content="Image Stats"  HorizontalAlignment="Left" FontSize="15" Foreground="White" FontStyle="Italic"  Margin="10,0,0,0"/>
        </StackPanel>
        <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Exit" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="ButtonClose_Click"/>
        </Border>

        <TextBlock Name="TextBlock" Text="Load Images and Start Auto Pilot Process" Foreground="Wheat"
				   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="117,23.8,78,414" Grid.Row="1" RenderTransformOrigin="0.508,0.618"/>
        <GroupBox Header="Image Details" Margin="0,10,0,0" Foreground="#FFF33E98" FontSize="15" FontWeight="SemiBold" BorderBrush="Pink" BorderThickness="0.2" Height="447" VerticalAlignment="Top" Grid.Row="1">
            <TreeView Background="#3F0A3854" FontWeight="Normal" Foreground="White" Name="trvMenu" Grid.Row="2" Height="411" VerticalAlignment="Top" IsEnabled="True" Margin="0,10,0.2,-1">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                        <TextBlock Text="{Binding Title}" Foreground="{Binding ItemsColors}"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </GroupBox>

    </Grid>
</Window>
