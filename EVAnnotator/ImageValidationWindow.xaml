<Window x:Class="GenieSupervisor.ImageValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenieSupervisor"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextElement.FontFamily="Segoe UI"
        Left="300" Top="100" WindowStyle="None" BorderThickness="1" Width="750" Height="auto" BorderBrush="Black"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False" MinHeight="400">
    <Grid Background="#FF686262">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="30">
            <Label Content="Image Validation Report"  HorizontalAlignment="Left" FontSize="15" Foreground="White" FontStyle="Italic" Margin="10,0,0,0"/>
        </StackPanel>
        <Border Cursor="Hand" Height="30" Width="30" Visibility="Collapsed" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0,30,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="50" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="ExtraBold" VerticalAlignment="Center" ToolTip="Minimize" HorizontalAlignment="Center" Text="-" PreviewMouseLeftButtonDown="ButtonMinimize_Click"></TextBlock>
        </Border>
        <Border Cursor="Hand" Height="30" Width="30" CornerRadius="50" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,0">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF686262" Offset="0.968"/>
                    <GradientStop Color="Red"/>
                </RadialGradientBrush>
            </Border.Background>
            <TextBlock TextWrapping="Wrap" Height="30" Width="30" FontSize="18" TextAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Exit" HorizontalAlignment="Center" Text="x" PreviewMouseLeftButtonDown="ButtonSaveClose_Click"/>
        </Border>
        <Grid Grid.Row="1" Background="#FF4C3F3F">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <telerik:GroupBox Grid.Row="0" Header="DataSheet Loaded" Height="auto" Margin="5,5,5,0" Foreground="White" FontSize="12" FontFamily="Tahoma" BorderBrush="White" BorderThickness="1">
                <telerik:RadListBox x:Name="listLoadedFile" Grid.Row="1" Height="auto" Background="Transparent" ItemsSource="{Binding LoadedFileList}" MinHeight="25" MaxHeight="120" 
                         telerik:StyleManager.Theme="Expression_Dark" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="5,5,0,10">
                    <telerik:RadListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="0,2" FontSize="12" TextAlignment="Left" Foreground="Wheat" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
                        </DataTemplate>
                    </telerik:RadListBox.ItemTemplate>
                </telerik:RadListBox>
            </telerik:GroupBox>
            <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" Height="28" Margin="0,0,20,0">
                <Label Content="Total Image Counts : "  HorizontalAlignment="Left" Height="auto" VerticalAlignment="Center" FontSize="12" Foreground="WhiteSmoke" FontWeight="SemiBold" Margin="5,0,0,0"/>
                <Label x:Name="lblTotalCount" Content="0"  HorizontalAlignment="Left" Height="auto" VerticalAlignment="Center" FontSize="12" Foreground="Wheat" FontWeight="SemiBold" Margin="5,0,0,0"/>
            </StackPanel>
            <telerik:GroupBox x:Name="grpReport" Margin="0,0" Grid.Row="2" Header="Validation Report" Foreground="White" BorderBrush="White" BorderThickness="0.7" FontSize="12">
                <DataGrid x:Name="dgDatasheet" Margin="0" HorizontalContentAlignment="Center" Background="#FF5A5555" BorderBrush="Transparent" RowHeaderWidth="0" IsReadOnly="True" AutoGenerateColumns="True" GridLinesVisibility="Horizontal">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Background" Value="#FF948F88"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                            <Setter Property="BorderBrush" Value="White"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.ItemContainerStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="Wheat" />

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Gray"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True" >
                                    <Setter Property="Background" Value="#4F808080" />
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.ItemContainerStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>                            
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
            </telerik:GroupBox>
            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Height="30" Margin="0,0,35,5">
                <telerik:RadButton x:Name="btnValidate" Content="Validate" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" CornerRadius="10" Height="25" Padding="20,0" ToolTip="Validate" PreviewMouseLeftButtonDown="ButtonValidate_Click" Margin="20,0,0,0"/>
                <telerik:RadButton x:Name="btnCSVExport" Content="Export Original" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" CornerRadius="10" Height="25" Padding="20,0" ToolTip="Export validated data" PreviewMouseLeftButtonDown="ButtonValidate_Click" Margin="20,0,0,0"/>
                <telerik:RadButton x:Name="btnCSVDropExport" Content="Drop and Export CSV" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" CornerRadius="10" Height="25" Padding="20,0" ToolTip="Drop and Export loaded csv" PreviewMouseLeftButtonDown="ButtonValidate_Click" Margin="20,0,0,0"/>
                <telerik:RadButton x:Name="btnExit" Content="Ok" HorizontalAlignment="Center" BorderBrush="Black" Background="#FFE7E7E0" Foreground="Brown" FontSize="15" VerticalContentAlignment="Center" Width="auto" 
                        telerik:StyleManager.Theme="Expression_Dark" CornerRadius="10" Height="25" Padding="20,0" ToolTip="Close" PreviewMouseLeftButtonDown="ButtonSaveClose_Click" Margin="20,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
