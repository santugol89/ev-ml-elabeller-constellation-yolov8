                                            <telerik:RadRadioButton x:Name="radGammaJpeg" Foreground="OrangeRed" telerik:StyleManager.Theme="Office2016" FontWeight="SemiBold" FontSize="12" Content="JPEG" Height="20" Padding="10,0" Margin="10,0" CornerRadius="10" Checked="radAnalysisButton_Checked"/>
