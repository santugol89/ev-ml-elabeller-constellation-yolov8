                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <telerik:LayoutControlExpanderGroup Grid.Row="0" IsExpanded="True" VerticalContentAlignment="Top" Background="#3F0A3854" Margin="0" Padding="2,0,0,0" BorderBrush="HotPink" BorderThickness="0.5">
                        <telerik:LayoutControlExpanderGroup.Header>
                            <TextBlock Text="Folder Stats" Foreground="Wheat" FontFamily="Segoe UI" FontSize="12"/>
                        </telerik:LayoutControlExpanderGroup.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.65*"/>
                                <ColumnDefinition Width="0.35*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Total Images Present" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0" VerticalContentAlignment="Center"/>
                            <Label Content="{Binding TotalImagesPresent}" Grid.Row="0" Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Total Images Loaded" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0" VerticalContentAlignment="Center"/>
                            <Label Content="{Binding TotalImagesLoaded}" Grid.Row="1" Grid.Column="1"  FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Duplicates Found" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0" VerticalContentAlignment="Center"/>
                            <Label Content="{Binding TotalDuplicateImages}" Grid.Row="2" Grid.Column="1"  FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                        </Grid>
                    </telerik:LayoutControlExpanderGroup>

                    <telerik:LayoutControlExpanderGroup Grid.Row="1" IsExpanded="True" VerticalContentAlignment="Top" Margin="0,5,0,0" Background="#3F0A3854" Padding="2,0,0,0" BorderBrush="HotPink" BorderThickness="0.5">
                        <telerik:LayoutControlExpanderGroup.Header>
                            <TextBlock Text="{Binding LabelStatHeader}" Foreground="Wheat" FontFamily="Segoe UI" FontSize="12" />
                        </telerik:LayoutControlExpanderGroup.Header>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="{Binding MultiClassRowHeight}"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.65*"/>
                                <ColumnDefinition Width="0.35*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{Binding UnLabelledImagesContent}" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0"/>
                            <Label Grid.Row="0" Grid.Column="1" Content="{Binding TotalUnlabelledImages}" FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{Binding LabelledImagesContent}" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0"/>
                            <Label Grid.Row="1" Grid.Column="1" Content="{Binding TotalLabelledImages}" FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Correction Images" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0"/>
                            <Label Grid.Row="2" Grid.Column="1" Content="{Binding TotalCorrectionImages}" FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="Total Labelled Regions" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0"/>
                            <Label Grid.Row="3" Grid.Column="1" Content="{Binding TotalMultiClassLabelled}" FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                        </Grid>
                    </telerik:LayoutControlExpanderGroup>

                    <telerik:LayoutControlExpanderGroup Grid.Row="2" IsExpanded="True" Visibility="{Binding ValidationStatVisibility}" VerticalContentAlignment="Top" Padding="2,0,0,0" Background="#3F0A3854" Margin="0,5,0,0" BorderBrush="HotPink" BorderThickness="0.5">
                        <telerik:LayoutControlExpanderGroup.Header>
                            <TextBlock Text="Data Validation Stats" Foreground="Wheat" FontFamily="Segoe UI" FontSize="12" />
                        </telerik:LayoutControlExpanderGroup.Header>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.65*"/>
                                <ColumnDefinition Width="0.35*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Total Datasheets" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0"/>
                            <Label Grid.Row="0" Grid.Column="1" Content="{Binding TotalDataSheet}" FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Total Records" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0"/>
                            <Label Grid.Row="1" Grid.Column="1" Content="{Binding TotalRecordFound}" FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Violated Data" FontSize="13" FontWeight="Regular" Foreground="White" Margin="0"/>
                            <Label Grid.Row="2" Grid.Column="1" Content="{Binding TotalViolationFound}" FontSize="13" FontWeight="Bold" Foreground="#FFEAE67C" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                        </Grid>
                    </telerik:LayoutControlExpanderGroup>

                    <telerik:LayoutControlExpanderGroup Grid.Row="3" IsExpanded="True" Visibility="{Binding ColorROIInfoVisibility}" VerticalContentAlignment="Top" Margin="0,5,0,0" Background="#3F0A3854" Padding="2,0,0,0" BorderBrush="HotPink" BorderThickness="0.5">
                        <telerik:LayoutControlExpanderGroup.Header>
                            <TextBlock Text="Annotation Info" Foreground="Wheat" FontFamily="Segoe UI" FontSize="12" />
                        </telerik:LayoutControlExpanderGroup.Header>

                        <Grid Width="auto" Height="100">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.65*"/>
                                <ColumnDefinition Width="0.35*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Column="0" Grid.Row="0" Content="Ground Truth ROI" FontSize="11" Foreground="White" Margin="0" VerticalAlignment="Center"/>
                            <Label Grid.Column="0" Grid.Row="1" Content="Predicted ROI" FontSize="11" Foreground="White" Margin="0" VerticalAlignment="Center"/>
                            <Label Grid.Column="0" Grid.Row="2" Content="Ground Truth ROI Selected" FontSize="11" Foreground="White" Margin="0" VerticalAlignment="Center"/>
                            <Label Grid.Column="0" Grid.Row="3" Content="Predicted ROI Selected" FontSize="11" Foreground="White" Margin="0" VerticalAlignment="Center"/>

                            <Label Grid.Column="1" Grid.Row="0" Content="--------" FontSize="13" FontWeight="Bold" Foreground="{Binding GroundTruthStroke}" Margin="0" VerticalAlignment="Center"/>
                            <Label Grid.Column="1" Grid.Row="1" Content="--------" FontSize="13" FontWeight="Bold" Foreground="{Binding PredictedStroke}" Margin="0" VerticalAlignment="Center"/>
                            <Label Grid.Column="1" Grid.Row="2" Content="--------" FontSize="13" FontWeight="Bold" Foreground="{Binding GroundTruthHighLihtStroke}" Margin="0" VerticalAlignment="Center"/>
                            <Label Grid.Column="1" Grid.Row="3" Content="--------" FontSize="13" FontWeight="Bold" Foreground="{Binding PredictHighLightStroke}" Margin="0" VerticalAlignment="Center"/>
                        </Grid>
                    </telerik:LayoutControlExpanderGroup>

                    <telerik:LayoutControlExpanderGroup Grid.Row="4" IsExpanded="True" Margin="0,5,0,0" Padding="2,0,0,0" Background="#3F0A3854" BorderBrush="HotPink" BorderThickness="0.5">
                        <telerik:LayoutControlExpanderGroup.Header>
                            <TextBlock Text="Work Status" Foreground="Wheat" FontFamily="Segoe UI" FontSize="12" />
                        </telerik:LayoutControlExpanderGroup.Header>

                        <Grid Width="auto" Height="auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="0.5*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Last Saved : " FontStyle="Italic" FontSize="13" Foreground="LightPink" Margin="0" VerticalAlignment="Center"/>
                            <Label Grid.Column="1" Content="{Binding LastSavedWorkTime}" FontStyle="Italic" FontSize="13" FontWeight="SemiBold" Foreground="LightPink" Margin="15,0,2,0" HorizontalAlignment="Right"/>
                        </Grid>
                    </telerik:LayoutControlExpanderGroup>
                </Grid>
            </Grid>

            <GridSplitter x:Name="gSplitHorizontal" Grid.Row="2" Grid.Column="2" Height="2" VerticalAlignment="Center" Focusable="False" HorizontalAlignment="Stretch" Background="#FF5D5F54" Margin="0,0,0,0" Visibility="{Binding IsVisibleInWorkshellMode}"/>
            <Grid x:Name="gridImageAttribute" Grid.Row="3" Grid.Column="2" Margin="0,0,0,0" Panel.ZIndex="0" Visibility="{Binding IsVisibleInWorkshellMode}">
                <TabControl TabStripPlacement="top" Background="#FF929C9C" BorderBrush="#FF3C3A3A" BorderThickness="1">
                    <TabControl.Resources>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Background" Value="#FF282828"/>
                            <Setter Property="BorderBrush" Value="#FF282828"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TabItem}">
                                        <Border x:Name="Border" Background="Transparent">
                                            <ContentPresenter x:Name="ContentSite" ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True" SourceName="Border">
                                                <Setter TargetName="Border" Property="Background" Value="#FF5D5757"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#FF5D5757"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem  Margin="0" Width="140" Height="25" Padding="0">
                        <TabItem.Header>
                            <DockPanel VerticalAlignment="Center">
                                <Label Content="Image Attribute" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="Transparent"  Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                            </DockPanel>
                        </TabItem.Header>
                        <Grid Width="auto">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="SPAddClass" Grid.Row="0" Height="25" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsEnableClassStackPanel}">
                                <Label Content="Class ID" FontWeight="Bold" Margin="5,0" Visibility="Collapsed"/>
                                <TextBox x:Name="txtClassID" Width="150" Visibility="Collapsed" VerticalAlignment="Center" IsEnabled="False" VerticalContentAlignment="Center" Margin="5,0"/>
                                <Label Content="Class Name" FontWeight="Bold" Margin="30,0,5,0"/>
                                <telerik:RadComboBox x:Name="cmbClassName" Width="300" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="5,0" telerik:StyleManager.Theme="Fluent"
                                        SelectionChanged="cmbClassName_SelectionChanged" DropDownClosed="cmbClassName_DropDownClosed" KeyDown="cmbClassName_KeyDown"/>

                                <Button x:Name="btnAddClass" Content="Add Class" Visibility="Collapsed" Background="#FFBEE5EE" BorderBrush="White" Cursor="Hand" Foreground="#FF272728" Margin="20,0" Padding="10,0" PreviewMouseDown="AddClassButton_Click">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock FontStyle="Normal"><Run Text="Add to Class"/></TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>
                            <ListView Grid.Row="1" Margin="0" HorizontalContentAlignment="Center" Foreground="Black" FontWeight="Medium" FontSize="13" 
                                  x:Name="lvImageClass" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#FFDFDADA" 
                                  SelectionChanged="ListViewItemClass_SelectionChanged" LostFocus="ListViewClass_LostFocus" PreviewKeyDown="ListClassView_KeyDown">
                                <ListView.Resources>
                                    <DataTemplate x:Key="DataTemplate">
                                        <Border BorderBrush="White" BorderThickness="1,0,0,0"/>
                                    </DataTemplate>
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <!--<Setter Property="HorizontalContentAlignment" Value="Center" />-->
                                        <Setter Property="BorderBrush" Value="white"></Setter>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"></Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.View>
                                    <GridView>
                                        <GridView.ColumnHeaderContainerStyle>
                                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="#FFD0C3B3"/>
                                            </Style>
                                        </GridView.ColumnHeaderContainerStyle>

                                        <GridViewColumn Width="100" Header="Correction">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox x:Name="chkClassReview" IsThreeState="False" IsChecked="{Binding Reviewed, Mode=TwoWay}" Click="ClassCheckBox_Click" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Class Index" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Path=ClassIndex}" TextAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Class Name" Width="{Binding ClassNameListViewWidth}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Path=ClassName}" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Coordinates" Width="{Binding AttributeListViewWidth}">          <!--Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListView}}, Converter={StaticResource lvAutoWidth}}"-->
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Path=ShapeCoordinates}" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            <StatusBar Grid.Row="4" Grid.ColumnSpan="3" Background="#FF007ACC" Height="25" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"></ColumnDefinition>
                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem Grid.Column="0" x:Name="sbSideBarButton">
                    <Border Name="Hidebtn" Width="25" Height="25" Background="#FF007ACC" CornerRadius="50" PreviewMouseLeftButtonDown="WarningExpandMouseLeftButtonDown" Cursor="Hand" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Name="Hide" Background="#FF007ACC" Foreground="White" Kind="ArrowLeftBoldCircle" Height="23" Width="23" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                        <Border.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock FontStyle="Italic" Text="Hide SideBar"/>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                    </Border>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1" MinWidth="650" MaxWidth="850">
                    <Label x:Name="tbStatusImageFile" Content="{Binding StatusBarImageFile}" Foreground="White" Height="auto" VerticalAlignment="Center" HorizontalAlignment="Left"  Padding="5,0"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="2" Margin="20,0,0,0">
                    <Label x:Name="tbStatusDimension"  Content="{Binding StatusBarDimension}" Foreground="White" Height="auto" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="0"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="3" Margin="20,0,0,0">
                    <Label x:Name="tbSelectedDimension" Content="{Binding StatusSelectedDimension}" Foreground="White" Height="auto" Width="auto" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="0"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="4" HorizontalAlignment="Right" HorizontalContentAlignment="Right">
                    <Grid>
                        <Label x:Name="lblStatusNote" Visibility="{Binding StatusNoteVisiblity}" FontStyle="Italic" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,0,0,0"/>
                        <Label x:Name="lblAugmentStatus" Visibility="Collapsed" FontStyle="Italic" Foreground="LightGoldenrodYellow" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,0,0,0"/>
                        <Label x:Name="lblAutoPilotStatus" Visibility="Collapsed" FontStyle="Italic" Foreground="LightGoldenrodYellow" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,0,0,0"/>
                        <Label x:Name="lblImgAnalyzeStatus" Visibility="Collapsed" FontStyle="Italic" Foreground="LightGoldenrodYellow" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,0,0,0"/>
                        <ProgressBar x:Name="pbarLoad" Height="15" Width="170" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility ="Collapsed" Foreground="#FF777676"/>
                    </Grid>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </telerik:RadBusyIndicator>
</Window>
