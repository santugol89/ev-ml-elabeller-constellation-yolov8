<Window x:Class="GenieSupervisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenieSupervisor"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"        
        Title="E-Labeller" Topmost="False" ResizeMode="CanMinimize" PreviewKeyDown="MainWindow_KeyDown" WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="LightBlue" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="gray" TargetName="Border" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShapeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="LightBlue" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF6F94AE" TargetName="Border" />
                            </Trigger>

                            <!--<Trigger Property="IsFocused" Value="True">
                                <Setter Property="Background" Value="#FFD9B9F9" TargetName="Border" />
                            </Trigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationBorderStyle" TargetType="{x:Type Button}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="LightGoldenrodYellow"></Setter>
                    <Setter Property="BorderThickness" Value="0"></Setter>
                    <Setter Property="Background" Value="White"></Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="BorderBrush" Value="White"></Setter>
                    <Setter Property="BorderThickness" Value="0"></Setter>
                    <Setter Property="Background" Value="Transparent"></Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Storyboard x:Key="sbHideZoomLabel" >
            <DoubleAnimation Storyboard.TargetProperty="Opacity"  From="1" To="1" Duration="0:0:3" />
            <!--label shows for 3 sec-->
            <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:3" From="1" To="0" DecelerationRatio=".5" Duration="0:0:2" />
            <!--Fade out the label after 3 sec-->
        </Storyboard>
        <ContextMenu x:Key="ClassContextMenu">
            <MenuItem Header="Add To Class" IsCheckable="False" PreviewMouseLeftButtonDown="AddImageAttributeToClass_Click"/>
        </ContextMenu>
    </Window.Resources>
    <telerik:RadBusyIndicator x:Name="busyIndicator" BusyContent="Please wait.." Background="Transparent" Foreground="White" FontSize="12" 
                              IsIndeterminate="True" Width="auto" DisplayAfter="0" telerik:StyleManager.Theme="Expression_Dark" VerticalContentAlignment="Stretch">
        <Grid Background="#FF3C3A3A" x:Name="gridMain" PreviewMouseDown="gridMain_PreviewMouseDown">
            <Grid.Resources>
                <local:WidthConverter x:Key="lvAutoWidth"/>
                <local:InvertVisibilityConverter x:Key="InvertVisibilityConverter"/>
                <local:BoolToVisibilityConverter x:Key="VisibilityBoolConverter"/>
                <local:VisibilityToBoolConverter x:Key="BoolToVisibilityConverter"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="25"/>-->
                <RowDefinition Height="auto"/>
                <RowDefinition Height="0.7*"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="gridRibbon" Grid.Row="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Label x:Name="buttonLogo" Width="60" Height="20" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0.9" Padding="2">
                    <Image Source="icon/EV_icon.png" Stretch="Fill"/>
                </Label>
                <Label Content="ver 1.0.0.1(For Reference)" Width="auto" Grid.Column="1" Grid.Row="0" Foreground="Goldenrod" FontSize="10" FontWeight="SemiBold"/>

                <telerik:RadRibbonView x:Name="RibbonWin" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4" BorderThickness="0" TitleBarVisibility="Collapsed"
                                   IsMinimized="False" ApplicationButtonVisibility="Collapsed" MinimizeButtonVisibility="Visible" QuickAccessToolBarPosition="AboveRibbon" FontSize="13">
                    <telerik:RadRibbonView.ApplicationMenu>
                        <telerik:ApplicationMenu Visibility="Collapsed"/>
                    </telerik:RadRibbonView.ApplicationMenu>

                    <telerik:StyleManager.Theme>
                        <telerik:SummerTheme/>
                    </telerik:StyleManager.Theme>

                    <telerik:RadRibbonTab x:Name="ribFileTab" Grid.Column="1" BorderThickness="1" Foreground="Black">
                        <telerik:RadRibbonTab.Header>
                            <TextBlock Text="File" Padding="15,0" VerticalAlignment="Center" FontSize="14"/>
                        </telerik:RadRibbonTab.Header>
                        <telerik:RadRibbonGroup x:Name="General" BorderThickness="1" BorderBrush="LightGoldenrodYellow">
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="General" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="OpenFolderButton" LargeImage="icon/load.png" Size="Large" Text="Load Images" 
                                                 Foreground="Black" ToolTip="Load Images from folder(F2/ Ctrl+O)" Padding="15,0,5,0" Click="LoadImageFolder_Click"/>
                            <telerik:RadRibbonButton x:Name="ImportButton" LargeImage="icon/import.png" Text="Import CSV" Size="Large" Visibility="Collapsed"
                                                 Foreground="Black" ToolTip="Import CSV File (F4/ Ctrl+I)" Padding="15,0" Click="ImportCSV_Click"/>.
                            <telerik:RadRibbonButton x:Name="ImportMultitButton" LargeImage="icon/Multiimport.png" Size="Large" Text="Import CSV" Visibility="{Binding IsVisibleInWorkshellMode}"
                                                 Foreground="Black" ToolTip="Import multiple CSV files (F4/ Ctrl+I)" Padding="15,0" Click="ImportMultipleCSV_Click"/>
                            <telerik:RadRibbonButton x:Name="ExportButton" LargeImage="icon/Export.png" Text="Export as CSV" Size="Large" Visibility ="{Binding ElementName=ExportMultiCSVMenu, Path=Visibility, Converter={StaticResource InvertVisibilityConverter}}"
                                      Foreground="Black" ToolTip="Export as CSV File (F6/ Ctrl+X)" Padding="15,0" Click="CSVSingleExport_Click"/>

                            <telerik:RadRibbonDropDownButton x:Name="ExportMultiCSVMenu" LargeImage="icon/Export.png" Size="Large" Visibility="{Binding IsVisibleMultiCSVExport}" Text="Export as CSV" 
                                            Foreground="Black" ToolTip="Export as CSV File" Padding="15,0">
                                <telerik:RadRibbonDropDownButton.DropDownContent>
                                    <StackPanel Orientation="Vertical">
                                        <telerik:RadMenuItem x:Name="MenuExportSingle" Header="Export Single CSV" Height="35" Padding="15,5" FontSize="12" Click="CSVExport_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/singl_CSVExport.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>

                                        <telerik:RadMenuItem x:Name="MenuExportMulti" Header="Export Multiple CSV" Height="35" Padding="15,5" FontSize="12" Click="CSVExport_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/multi_CSVExport.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>
                                    </StackPanel>
                                </telerik:RadRibbonDropDownButton.DropDownContent>
                            </telerik:RadRibbonDropDownButton>

                            <telerik:RadRibbonButton x:Name="ExportSegregateButton" LargeImage="icon/export_segregated.png" Text="Export Segregated Images" Size="Large" Visibility="Collapsed"
                                      Foreground="Black" ToolTip="Export Segregated Images" Padding="15,0" Click="ExportSegregateButton_Click"/>

                            <telerik:RadRibbonButton x:Name="SegregateAllButton" Size="Large" Text="Segregate All Images" Margin="10,0,15,0"
                                Foreground="Black" ToolTip="Select All Image and Segregate" Padding="5,0" Click="SegregateAllButton_Click">
                                <materialDesign:PackIcon Kind="SelectAll" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="DarkGoldenrod"/>
                            </telerik:RadRibbonButton>
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup BorderThickness="1" x:Name="rbgJson" BorderBrush="LightGoldenrodYellow" Visibility="Collapsed">
                            <!--Visibility="{Binding IsVisibleInWorkshellMode}"-->
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="JSON" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="ImportJasontButton" LargeImage="icon/jsonImport.png" Size="Large" Visibility="Visible" Text="Import JSON" 
                                                Foreground="Black" ToolTip="Import multiple JSON files (F5/ Ctrl+M)" Padding="15,0" Click="ImportMultipleJSON_Click"/>
                            <!--<telerik:RadRibbonButton x:Name="ExportJasontButton" LargeImage="icon/json.png" Size="Large" Visibility="Visible" Text="Export as JSON" 
                                                Foreground="#FF232222" ToolTip="Export as JSON File (F7/ Ctrl+J)" Padding="15,0" Click="JSONExport_Click"/>-->

                            <telerik:RadRibbonDropDownButton x:Name="ExportJasontButton" LargeImage="icon/json.png" Size="Large" Visibility="Visible" Text="Export as JSON" 
                                            Foreground="#FF232222" ToolTip="Export as JSON File (F7/ Ctrl+J)" Padding="15,0">
                                <telerik:RadRibbonDropDownButton.DropDownContent>
                                    <StackPanel Orientation="Vertical">
                                        <telerik:RadMenuItem Header="MRCNN Compatible" Padding="15,5" Height="35" FontSize="12" Click="JSONExport_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/json.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>

                                        <telerik:RadMenuItem Header="COCO Compatible" Padding="15,5" Height="35" FontSize="12" Click="JSONExport_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/json.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>
                                    </StackPanel>
                                </telerik:RadRibbonDropDownButton.DropDownContent>
                            </telerik:RadRibbonDropDownButton>
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup BorderThickness="1" x:Name="rbgXML" BorderBrush="LightGoldenrodYellow" Visibility="Collapsed">
                            <!--Visibility="{Binding IsVisibleInWorkshellMode}"-->
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="XML" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="ImportXMLButton" LargeImage="icon/importXml.png" Size="Large" Visibility="Visible" Text="Import XML" 
                                                Foreground="Black" ToolTip="Import XML File" Padding="15,0" Click="ImportXMLButton_Click"/>
                            <telerik:RadRibbonButton x:Name="ExportXMLButton" LargeImage="icon/XMLicon.png" Size="Large" Visibility="Visible" Text="Export as XML" 
                                                Foreground="Black" ToolTip="Export as XML File" Padding="15,0" Click="ExportXMLButton_Click"/>
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup BorderThickness="1" x:Name="rbgSettings" BorderBrush="LightGoldenrodYellow">
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="Settings" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="SettingsButton" LargeImage="icon/Settings.png" Text="Settings" Size="Large"
                                                 ToolTip="Settings" Foreground="Black" Padding="15,0" Click="SettingsWindow_Click" />
                            <!--<RibbonMenuButton x:Name="ProjectMenu" LargeImageSource="icon/ProjectManage.png" Label="Manage Projects" Foreground="Black" ToolTip="Manage Projects" Padding="15,0">
                            <RibbonMenuItem Header="New Project" ImageSource="icon/AddProject.png" Padding="15,5" FontSize="12" Click="ManageProjectButton_Click"/>
                            <RibbonMenuItem Header="Modify/Delete Project" ImageSource="icon/EditProject.png" Padding="15,0" FontSize="12" Click="ManageProjectButton_Click"/>
                        </RibbonMenuButton>-->

                            <telerik:RadRibbonDropDownButton x:Name="ProjectMenu" LargeImage="icon/ProjectManage.png" Size="Large" Text="Manage Projects" 
                                            Foreground="Black" ToolTip="Manage Projects" Padding="15,0" Visibility="{Binding IsVisibleInWorkshellMode}" >
                                <telerik:RadRibbonDropDownButton.DropDownContent>
                                    <StackPanel Orientation="Vertical">
                                        <telerik:RadMenuItem Header="New Project" Padding="15,5" FontSize="12" Height="35" Click="ManageProjectButton_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/AddProject.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>

                                        <telerik:RadMenuItem Header="Modify/Delete Project" Padding="15,5" FontSize="12" Height="35" Click="ManageProjectButton_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/EditProject.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>
                                    </StackPanel>
                                </telerik:RadRibbonDropDownButton.DropDownContent>
                            </telerik:RadRibbonDropDownButton>
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup Grid.Row="1" BorderThickness="1" x:Name="rbgDataSplit" BorderBrush="LightGoldenrodYellow">
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="Data" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="DataSplit" LargeImage="icon/SplitFile.png" Text="Train/Val/Test Data Splitter" Size="Large" 
                                                 ToolTip="Split Data into train/val/test" Foreground="Black" Padding="15,0" Click="DataSplit_Click" />
                            <telerik:RadRibbonButton x:Name="btnAugmentation" LargeImage="icon/augmentation.png" Text="Data Augmentation" Size="Large" 
                                                 ToolTip="Image Augmentation for train folder" Foreground="Black" Padding="15,0" Click="btnAugmentation_Click" />
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup BorderThickness="1" x:Name="rbgHistory" BorderBrush="LightGoldenrodYellow" Visibility="{Binding IsVisibleInWorkshellMode}">
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="History" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="SaveButton" LargeImage="icon/save.png" Text="Save Work" Size="Large"
                                                 Foreground="Black" ToolTip="Save Processed Images " Padding="15,0" Click="SaveProcessedWork_Click"/>
                            <!--<RibbonMenuButton x:Name="HistoryMenu" LargeImageSource="icon/history.png" Label="History" 
                                          Foreground="Black" ToolTip="Last Annotation Work" Padding="15,0">
                            <RibbonMenuItem Header="Load Last Annotated Work" ImageSource="icon/loadhistory.png" Padding="15,5" FontSize="12" Click="LoadLastWork_Click"/>
                            <RibbonMenuItem Header="Clear History" ImageSource="icon/clearHistory.png" Padding="15,0" FontSize="12" Click="ClearHistory_Click"/>
                        </RibbonMenuButton>-->

                            <telerik:RadRibbonDropDownButton x:Name="HistoryMenu" LargeImage="icon/history.png" Size="Large" Visibility="Visible" Text="History" 
                                            Foreground="Black" ToolTip="Last Annotation Work" Padding="15,0">
                                <telerik:RadRibbonDropDownButton.DropDownContent>
                                    <StackPanel Orientation="Vertical">
                                        <telerik:RadMenuItem Header="Load Last Annotated Work" Padding="15,5" Height="35" FontSize="12" Click="LoadLastWork_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/loadhistory.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>

                                        <telerik:RadMenuItem Header="Clear History" Padding="15,5" FontSize="12" Height="35" Click="ClearHistory_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/clearHistory.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>
                                    </StackPanel>
                                </telerik:RadRibbonDropDownButton.DropDownContent>
                            </telerik:RadRibbonDropDownButton>
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup BorderThickness="1" x:Name="rbgManageDatasheet" BorderBrush="LightGoldenrodYellow" Visibility="Collapsed">
                            <!--Visibility="{Binding IsVisibleInWorkshellMode}"-->
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="Manage" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="ManageDatasheetButton" LargeImage="icon/manage.png" Size="Large" Text="Manage/Merge Datasheet" 
                                        Foreground="Black" ToolTip="Manage and Merge Datasheet " Padding="15,0" Click="ManageDatasheetButton_Click"/>
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup BorderThickness="1" x:Name="rbgPrediction" Visibility="Collapsed" BorderBrush="LightGoldenrodYellow">
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="Prediction" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="ImportTextButton" LargeImage="icon/importText.png" Size="Large" Visibility="Visible" Text="Import Prediction Text" 
                                                Foreground="Black" ToolTip="Import Prediction meta data" Padding="10,0" Click="ImportTextButton_Click"/>
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup x:Name="radRibGroupWorkcell" BorderThickness="1" BorderBrush="LightGoldenrodYellow" Visibility="Collapsed">
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="Workcell" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="ImportWorkcellJsonButton" LargeImage="icon/jsonImport.png" Size="Large" Visibility="Collapsed" Text="Import Workcell JSON" 
                                                Foreground="Black" ToolTip="Import Workcell Json files" Padding="15,0" Click="ImportWorkcellJSON_Click"/>
                            <telerik:RadRibbonButton x:Name="WorkcellModeButton" LargeImage="icon/Workcell.png" Size="Large" Visibility="Visible" Text="Enable Workcell" 
                                                Foreground="Black" ToolTip="Enable Workcell mode" Padding="15,0" Click="SwitchWorkcellModeButton_Click"/>
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup x:Name="radRibEdit" BorderThickness="1" BorderBrush="LightGoldenrodYellow" Visibility="Collapsed">
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="Edit" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="UndoButton" LargeImage="icon/undo.png" Text="Undo" IsEnabled="False" Size="Large" ToolTip="Undo (Ctrl+Z)" 
                                                 Foreground="Black" Visibility="Visible" Padding="15,0" Click="UndoChangestoCanvas_Click" />
                            <telerik:RadRibbonButton x:Name="RedoButton" LargeImage="icon/redo.png" Text="Redo" Size="Large" ToolTip="Redo (Ctrl+Y)" 
                                                 Foreground="Black" Visibility="Visible" Padding="15,0" Click="RedoChanges_Click"/>

                            <telerik:RadRibbonButton x:Name="RemoveButton" LargeImage="icon/RemoveMulti.png" Text="Remove Multiple Overlays" Size="Large" ToolTip="Remove Multiple Overlays" 
                                                 Foreground="Black" Visibility="Collapsed" Padding="15,0" Click="RemoveMultipleButton_Click"/>
                        </telerik:RadRibbonGroup>

                        <telerik:RadRibbonGroup BorderThickness="1" BorderBrush="LightGoldenrodYellow">
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="Reset" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="ResetButton" LargeImage="icon/resetIcon.png" Size="Large" Visibility="Visible" Text="Reset All" 
                                                Foreground="Black" ToolTip="Reset all Stats(Ctrl+R)" Padding="15,0" Click="ResetAll_Click"/>
                        </telerik:RadRibbonGroup>
                    </telerik:RadRibbonTab>

                    <telerik:RadRibbonTab Grid.Column="1" x:Name="ribEditTab" IsSelected="False" BorderThickness="1" Foreground="Black">
                        <telerik:RadRibbonTab.Header>
                            <TextBlock Text="Extras" Padding="15,0" VerticalAlignment="Center" FontSize="14"/>
                        </telerik:RadRibbonTab.Header>

                        <telerik:RadRibbonGroup Grid.Row="1" BorderThickness="1" x:Name="rbgEdit" BorderBrush="LightGoldenrodYellow" Visibility="{Binding IsVisibleInWorkshellMode}">
                            <telerik:RadRibbonGroup.Header>
                                <TextBlock Text="Operation" Foreground="Brown" Opacity="0.5" VerticalAlignment="Center" Height="20" HorizontalAlignment="Center" FontSize="13"/>
                            </telerik:RadRibbonGroup.Header>
                            <telerik:RadRibbonButton x:Name="DuplicateStatButton" LargeImage="icon/duplicatestat.png" Size="Large" Text="Duplicate Image Stats" 
                                                 ToolTip="Duplicate Images Statistics" Foreground="Black" Padding="15,0" Click="DuplicateImageStats_Click" />
                            <telerik:RadRibbonButton x:Name="ValidationButton" LargeImage="icon/csvvalidation.png" Size="Large" Text="CSV Validation"
                                                 ToolTip="CSV file Validation" Foreground="Black" Padding="15,0" Click="ValidationCSV_Click" />
                            <telerik:RadRibbonButton x:Name="ImageValidButton" LargeImage="icon/imgvalid.png" Size="Large" Text="Image Validation" ToolTip="Image Validation" 
                                                 Foreground="Black" Padding="15,0" Click="ImageValidation_Click"/>
                            <telerik:RadRibbonButton x:Name="ClassStatsButton" LargeImage="icon/folderstat.png" Size="Large" Text="Folder Stats" ToolTip="Class Folder Statistics" 
                                                 Foreground="Black" Padding="15,0" Click="ClassStatsButton_Click"/>
                            <telerik:RadRibbonButton x:Name="IDAssignerButton" LargeImage="icon/idAssign.png" Size="Large" Text="ID Assigner" ToolTip="Class ID Assigner" 
                                                 Foreground="Black" Padding="15,0" Click="IDAssignerButton_Click" Visibility="Collapsed"/>

                            <telerik:RadRibbonDropDownButton x:Name="FolderSplitButton" LargeImage="icon/FolderSplit.png" Size="Large" Visibility="Collapsed" Text="Data Folder Splitter" 
                                            Foreground="Black" ToolTip="Image Folder Splitter" Padding="15,0">
                                <telerik:RadRibbonDropDownButton.DropDownContent>
                                    <StackPanel Orientation="Vertical">
                                        <telerik:RadMenuItem x:Name="menuCopyFolder" Header="Copy Folder" Padding="15,5" Height="35" FontSize="12" Click="DataFolderSplitter_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/copy.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>

                                        <telerik:RadMenuItem x:Name="menuMoveFolder" Header="Move Folder" Padding="15,5" Height="35" FontSize="12" Click="DataFolderSplitter_Click">
                                            <telerik:RadMenuItem.Icon>
                                                <Image Source="icon/FolderSplit.png" />
                                            </telerik:RadMenuItem.Icon>
                                        </telerik:RadMenuItem>
                                    </StackPanel>
