                                    <MenuItem x:Name="menuSave" Header="Save to disk" InputGestureText="Ctrl+S" IsEnabled="False" IsCheckable="False"/>
                                    <MenuItem x:Name="menuShowBoundBox" Header="Show Bound Box" InputGestureText="Ctrl+B" IsEnabled="False" IsCheckable="False"/>
                                </ContextMenu>
                            </Canvas.ContextMenu>
                        </Canvas>
