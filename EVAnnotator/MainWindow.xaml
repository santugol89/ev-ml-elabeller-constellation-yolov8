                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Classes" Margin="10,5" Padding="0" Height="auto" Width="auto" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="LightGoldenrodYellow" FontSize="14"/>
